---
import Layout from './Layout.astro';
import Header from '../components/HeaderDropdown.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  heading?: string;
}
const { title, heading } = Astro.props;
---
<Layout title={title + ' — Артель'}>
  <Header />
  <main class="placeholder">
    <div class="placeholder__wrap">
      <p class="placeholder__label">В разработке</p>
      <h1>{heading ?? title}</h1>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--spacing-64) var(--spacing-48);
  }
  .placeholder__wrap {
    text-align: center;
    max-width: 600px;
  }
  .placeholder__label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-900);
    margin-bottom: var(--spacing-16);
  }
  h1 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    font-weight: 600;
    color: var(--color-dark-900);
  }
</style>
