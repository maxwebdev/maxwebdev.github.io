---
import Layout from './Layout.astro';
import Header from '../components/HeaderDropdown.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface SidebarLink {
  label: string;
  href: string;
}

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  crumbs: Crumb[];
  sidebarLinks: SidebarLink[];
  sidebarTitle?: string;
  activeHref?: string;
}

const { title, description, crumbs, sidebarLinks, sidebarTitle = 'Разделы', activeHref } = Astro.props;
---

<Layout title={title + ' — Артель'}>
  <slot name="head" slot="head" />
  <Header />

  <div class="inner-page">
    <div class="inner-page__wrapper">

      <!-- Breadcrumbs -->
      <div class="inner-page__breadcrumbs">
        <Breadcrumbs crumbs={crumbs} />
      </div>

      <div class="inner-page__layout">

        <!-- Sticky sidebar -->
        <aside class="inner-page__sidebar">
          <!-- Desktop: обычный список -->
          <div class="sidebar sidebar--desktop">
            <p class="sidebar__title">{sidebarTitle}</p>
            <nav aria-label={sidebarTitle}>
              <ul class="sidebar__list">
                {sidebarLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class={`sidebar__link${activeHref === link.href ? ' sidebar__link--active' : ''}`}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <div class="sidebar__cta">
              <p class="sidebar__cta-title">Бесплатная консультация</p>
              <p class="sidebar__cta-text">Ответим на вопросы, оценим работу по фото — бесплатно и без обязательств.</p>
              <a href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20проконсультироваться" class="sidebar__cta-btn" target="_blank" rel="noopener">
                Написать в WhatsApp
              </a>
              <a href="tel:+79319616090" class="sidebar__cta-phone">+7 931 961-60-90</a>
            </div>
          </div>

          <!-- Mobile: аккордеон -->
          <details class="sidebar sidebar--mobile">
            <summary class="sidebar__summary">
              <span class="sidebar__summary-label">{sidebarTitle}</span>
              {sidebarLinks.find(l => l.href === activeHref)?.label && (
                <span class="sidebar__summary-active">
                  {sidebarLinks.find(l => l.href === activeHref)?.label}
                </span>
              )}
              <svg class="sidebar__summary-chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <nav aria-label={sidebarTitle}>
              <ul class="sidebar__list">
                {sidebarLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class={`sidebar__link${activeHref === link.href ? ' sidebar__link--active' : ''}`}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </aside>

        <!-- Main content -->
        <main class="inner-page__content" id="main-content">
          <slot />
        </main>

      </div>
    </div>
  </div>

  <!-- Мобильная фиксированная CTA-плашка -->
  <div class="mobile-cta" aria-label="Заказать консультацию">
    <a href="tel:+79319616090" class="mobile-cta__btn mobile-cta__btn--call">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.86 9.5a19.79 19.79 0 01-3-8.59A2 2 0 012.83 2h3a2 2 0 012 1.72c.13 1.05.38 2.09.73 3.09a2 2 0 01-.45 2.11L7.09 9.91a16 16 0 006.29 6.29l1-1a2 2 0 012.11-.45c1 .35 2.04.6 3.09.73A2 2 0 0122 16.92z"/>
      </svg>
      Позвонить
    </a>
    <a href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20проконсультироваться" class="mobile-cta__btn mobile-cta__btn--wa" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp
    </a>
  </div>

  <Footer />
</Layout>

<style is:global>
.inner-page {
  width: 100%;
  padding: var(--spacing-48) var(--spacing-48) var(--spacing-98);
  background-color: var(--color-bg-light);
}

.inner-page__wrapper {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-32);
}

.inner-page__breadcrumbs {
  /* хлебные крошки над основным лейаутом */
}

.inner-page__layout {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-48);
}

/* ── Sidebar ── */
.inner-page__sidebar {
  flex-shrink: 0;
  width: 220px;
}

.sidebar {
  position: sticky;
  top: calc(72px + var(--spacing-32)); /* высота хедера + отступ */
}

.sidebar__title {
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-gold-900);
  margin-bottom: var(--spacing-16);
}

.sidebar__list {
  display: flex;
  flex-direction: column;
  border-left: 1px solid var(--color-gold-600);
}

.sidebar__link {
  display: block;
  padding: 10px 16px;
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  border-left: 2px solid transparent;
  margin-left: -1px;
  line-height: 1.4;
  transition: color var(--transition-fast), border-left-color var(--transition-fast), background-color var(--transition-fast);
}

.sidebar__link:hover {
  color: var(--color-gold-900);
  border-left-color: var(--color-gold-600);
  background-color: var(--color-white);
}

.sidebar__link--active {
  color: var(--color-dark-900);
  border-left-color: var(--color-gold-900);
  font-weight: 500;
  background-color: var(--color-white);
}

/* Скрыть мобильный вариант на десктопе */
.sidebar--mobile {
  display: none;
}

/* ── Content ── */
.inner-page__content {
  flex: 1;
  min-width: 0;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .inner-page {
    padding: var(--spacing-32) var(--spacing-32) var(--spacing-64);
  }
  .inner-page__sidebar {
    width: 180px;
  }
}

/* ── Sidebar CTA ── */
.sidebar__cta {
  margin-top: var(--spacing-32);
  background: linear-gradient(154.68deg, var(--color-gold-300) 0%, var(--color-gold-600) 100%);
  border-radius: var(--radius-sm);
  padding: var(--spacing-24);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-16);
}

.sidebar__cta-title {
  font-family: var(--font-heading);
  font-size: var(--font-size-h4);
  font-weight: 600;
  color: var(--color-dark-900);
  line-height: 1.1;
}

.sidebar__cta-text {
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-muted);
}

.sidebar__cta-btn {
  display: block;
  text-align: center;
  padding: 12px var(--spacing-16);
  background: linear-gradient(135deg, #d4921e 0%, #c77d17 50%, #b36a10 100%);
  color: var(--color-gold-300);
  border: 1px solid var(--color-gold-900);
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  text-decoration: none;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.sidebar__cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(199, 125, 23, 0.30);
}

.sidebar__cta-phone {
  display: block;
  text-align: center;
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-gold-900);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.sidebar__cta-phone:hover {
  color: var(--color-dark-900);
}

/* ── Mobile fixed CTA ── */
.mobile-cta {
  display: none;
}

@media (max-width: 760px) {
  .mobile-cta {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 80;
    background: var(--color-dark-900);
    border-top: 1px solid rgba(240, 219, 190, 0.2);
    padding: var(--spacing-8) var(--spacing-16);
    gap: var(--spacing-8);
    padding-bottom: max(var(--spacing-8), env(safe-area-inset-bottom));
  }

  .mobile-cta__btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    padding: 12px var(--spacing-16);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .mobile-cta__btn:active {
    opacity: 0.8;
  }

  .mobile-cta__btn--call {
    background: linear-gradient(135deg, #d4921e 0%, #c77d17 50%, #b36a10 100%);
    color: var(--color-gold-300);
    border: 1px solid var(--color-gold-900);
  }

  .mobile-cta__btn--wa {
    background: transparent;
    color: var(--color-gold-600);
    border: 1px solid rgba(240, 219, 190, 0.3);
  }
}

@media (max-width: 760px) {
  .inner-page {
    padding: var(--spacing-24) var(--spacing-16) calc(var(--spacing-64) + 64px);
    overflow-x: hidden;
  }
  .inner-page__layout {
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-16);
  }
  .inner-page__sidebar {
    width: 100%;
  }

  /* Desktop-вариант скрыт на мобильных */
  .sidebar--desktop { display: none; }

  /* Mobile-аккордеон показываем */
  .sidebar--mobile {
    display: block;
    position: static;
    background: var(--color-white);
    border: 1px solid var(--color-gold-600);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .sidebar--mobile:hover {
    box-shadow: 0 4px 16px rgba(199,125,23,.10);
    transform: translateY(-2px);
  }

  .sidebar__summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .sidebar__summary::-webkit-details-marker { display: none; }

  .sidebar__summary-label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-900);
    flex-shrink: 0;
  }

  .sidebar__summary-active {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-gold-900);
    font-weight: 500;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar__summary-chevron {
    flex-shrink: 0;
    color: var(--color-dark-600);
    transition: transform var(--transition-fast);
    margin-left: auto;
  }

  details[open] .sidebar__summary-chevron {
    transform: rotate(180deg);
  }

  .sidebar--mobile .sidebar__list {
    border-left: none;
    border-top: 1px solid var(--color-gold-600);
    flex-direction: column;
    padding: 8px 0;
  }

  .sidebar--mobile .sidebar__link {
    padding: 10px 16px;
    font-size: var(--font-size-sm);
    border-left: 2px solid transparent;
    margin-left: 0;
  }

  .sidebar--mobile .sidebar__link:hover {
    border-left-color: var(--color-gold-600);
  }

  .sidebar--mobile .sidebar__link--active {
    border-left-color: var(--color-gold-900);
  }
}
</style>
