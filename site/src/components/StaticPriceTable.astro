---
// Статическая прайс-таблица для часовых страниц.
// В отличие от SanityPriceTable, не ходит в Sanity и хранит готовые ценники
// в рублях прямо в пропсах. Визуально совпадает с SanityPriceTable.

interface PriceRow {
  /** "section" — строка-заголовок группы (например, «НАРУЧНЫЕ»). */
  type?: 'section' | 'data';
  /** Текст услуги в первой колонке. */
  label: string;
  /** Значения по числу value-колонок. Пустая строка = "—". */
  cells?: string[];
}

interface Props {
  title: string;
  subtitle?: string;
  colHeaders: string[];
  rows: PriceRow[];
  footnote?: string;
}

const { title, subtitle, colHeaders, rows, footnote } = Astro.props;
const valueColCount = Math.max(0, colHeaders.length - 1);

function renderCell(text: string | undefined): string {
  const trimmed = (text ?? '').trim();
  if (!trimmed) return '—';
  return trimmed;
}
---

<section class="price-table-section">
  <div class="price-table-header">
    <p class="price-table-label">Прайс-лист</p>
    <h2 class="price-table-title">{title}</h2>
    {subtitle && <p class="price-table-subtitle">{subtitle}</p>}
  </div>

  <div class="price-table-wrap">
    <table class="price-table">
      <thead>
        <tr>
          {colHeaders.map((h, i) => (
            <th class={i === 0 ? 'price-table__th--label' : 'price-table__th--value'}>{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) =>
          row.type === 'section' ? (
            <tr class="price-table__section">
              <td colspan={colHeaders.length}>{row.label}</td>
            </tr>
          ) : (
            <tr>
              <td class="price-table__label">{row.label}</td>
              {Array.from({ length: valueColCount }).map((_, idx) => (
                <td class="price-table__price">{renderCell(row.cells?.[idx])}</td>
              ))}
            </tr>
          )
        )}
      </tbody>
    </table>
  </div>

  {footnote && (
    <div class="price-table-footer">
      <p class="price-table-footnote">{footnote}</p>
    </div>
  )}
</section>

<style>
.price-table-section {
  background: var(--color-white);
  border-radius: var(--radius-sm);
  padding: var(--spacing-48);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-32);
}

.price-table-header {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-8);
}

.price-table-label {
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-gold-900);
}

.price-table-title {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: var(--font-size-h2);
  line-height: 1.05;
  color: var(--color-dark-900);
}

.price-table-subtitle {
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  line-height: 1.6;
  color: var(--color-text-muted);
  max-width: 640px;
}

.price-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.price-table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  line-height: 1.5;
}

.price-table thead tr {
  border-bottom: 1px solid var(--color-gold-600);
}

.price-table th {
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--font-size-sm);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-dark-600);
  padding: 0 var(--spacing-16) var(--spacing-16) var(--spacing-16);
  text-align: left;
}

.price-table__th--label { padding-left: 0; }
.price-table__th--value { text-align: left; white-space: nowrap; }

.price-table td {
  padding: var(--spacing-16);
  border-bottom: 1px solid var(--color-gold-600);
  color: var(--color-dark-900);
  font-size: var(--font-size-base);
  vertical-align: top;
}

.price-table__label {
  padding-left: 0 !important;
}

.price-table__price {
  font-weight: 500;
  color: var(--color-gold-900);
  white-space: nowrap;
}

.price-table tbody tr:last-child td {
  border-bottom: none;
}

.price-table tbody tr {
  transition: background-color 200ms ease;
}

.price-table tbody tr:not(.price-table__section):hover {
  background-color: var(--color-gold-300);
}

/* Section-heading row inside the body */
.price-table__section td {
  font-weight: 500;
  font-size: var(--font-size-sm);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-dark-600);
  padding: var(--spacing-24) 0 var(--spacing-8) 0;
  border-bottom: 1px solid var(--color-gold-600);
  background: var(--color-gold-300);
}

.price-table__section:first-child td {
  padding-top: var(--spacing-8);
}

.price-table-footer {
  padding-top: var(--spacing-16);
  border-top: 1px solid var(--color-gold-600);
}

.price-table-footnote {
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-muted);
}

@media (max-width: 760px) {
  .price-table-section {
    padding: var(--spacing-32) var(--spacing-24);
  }

  .price-table-title {
    font-size: var(--font-size-h3);
  }

  .price-table td {
    padding: var(--spacing-16) var(--spacing-8);
  }

  .price-table th {
    padding: 0 var(--spacing-8) var(--spacing-16) var(--spacing-8);
  }

  .price-table__th--label { padding-left: 0; }
  .price-table__label { padding-left: 0 !important; }
}
</style>
