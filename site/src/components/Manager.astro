<section class="manager" id="manager">
  <div class="manager__wrapper">
    <div class="manager__header">
      <h2 class="manager__title">Ваш менеджер</h2>
      <p class="manager__subtitle">Поможет определиться с дизайном и рассчитает стоимость за один разговор</p>
    </div>
    <div class="manager__content">
      <div class="manager__photo">
        <img src="/images/manager-marina.jpg" alt="Марина Дмитриченко" />
      </div>
      <div class="manager__info">
        <h3 class="manager__name">Марина <em>Дмитриченко</em></h3>
        <p class="manager__bio">Ювелирный эксперт мастерской «Артель». Ответит на все вопросы о дизайне, материалах и стоимости. Ответ — в течение 30 минут.</p>
        <div class="manager__buttons">
          <a href="https://t.me/+79319616090" class="btn btn--primary">Telegram</a>
          <a href="https://wa.me/+79319616090" class="btn btn--primary">WhatsApp</a>
        </div>
        <p class="manager__phone">Или позвоните: <a href="tel:+79319616090" class="manager__phone-link">+7 931 961-60-90</a></p>
      </div>
    </div>
  </div>

  <div class="manager__mobile">
    <div class="manager__mobile-title">Ваш менеджер</div>
    <div class="manager__mobile-name">Марина <em>Дмитриченко</em></div>
    <div class="manager__mobile-content">
      <div class="manager__mobile-photo">
        <img src="/images/manager-marina.jpg" alt="Марина Дмитриченко" />
      </div>
      <div class="manager__mobile-actions">
        <a href="https://t.me/+79319616090" class="btn btn--primary">Telegram</a>
        <a href="https://wa.me/+79319616090" class="btn btn--primary">WhatsApp</a>
        <a href="tel:+79319616090" class="manager__mobile-phone">+7 931 961-60-90</a>
      </div>
    </div>
    <p class="manager__mobile-bio">Ювелирный эксперт мастерской «Артель». Ответит на все вопросы о дизайне, материалах и стоимости. Ответ — в течение 30 минут.</p>
  </div>
</section>

<style>
.manager {
  background-color: var(--color-dark-900);
  display: flex; flex-direction: column; align-items: center;
  padding: var(--spacing-132) var(--spacing-132); overflow: hidden; width: 100%;
}
.manager__wrapper {
  display: flex; flex-direction: column; gap: var(--spacing-64);
  max-width: 1400px; width: 100%;
}
.manager__header {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; gap: var(--spacing-48);
}
.manager__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1; color: var(--color-dark-300); flex: 1;
}
.manager__subtitle {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: var(--color-gold-900); text-align: right; flex: 1;
}
.manager__content {
  display: flex; gap: var(--spacing-48); align-items: center; width: 100%;
}
.manager__photo { width: 400px; height: 484px; flex-shrink: 0; overflow: hidden; }
.manager__photo img { width: 100%; height: 100%; object-fit: cover; }
.manager__info {
  flex: 1; display: flex; flex-direction: column; gap: var(--spacing-24); min-width: 0;
}
.manager__name {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1; color: var(--color-dark-300); white-space: nowrap;
}
.manager__name em { font-style: italic; color: var(--color-gold-600); }
.manager__bio {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: rgba(255,255,255,0.55);
}
.manager__buttons {
  display: flex; gap: var(--spacing-32); align-items: center;
  padding-top: var(--spacing-24); border-top: 1px solid var(--color-gold-600); width: 100%;
}
.manager__phone {
  font-family: var(--font-body); font-size: var(--font-size-h6);
  line-height: 1.3; color: rgba(255,255,255,0.4);
}
.manager__phone-link {
  color: var(--color-white); transition: color var(--transition-fast); white-space: nowrap;
}
.manager__phone-link:hover { color: var(--color-gold-600); }

/* Mobile-only manager block */
.manager__mobile { display: none; flex-direction: column; gap: 16px; width: 100%; }
.manager__mobile-title {
  font-family: var(--font-heading); font-weight: 600; font-size: 30px;
  line-height: 1; color: var(--color-dark-300);
}
.manager__mobile-name {
  font-family: var(--font-heading); font-weight: 600; font-style: italic;
  font-size: 30px; line-height: 1; color: var(--color-dark-300);
}
.manager__mobile-name em { font-style: italic; color: var(--color-gold-600); }
.manager__mobile-content {
  display: flex; gap: 16px; align-items: flex-start; padding-top: var(--spacing-24);
}
.manager__mobile-photo { width: 104px; height: 150px; flex-shrink: 0; overflow: hidden; }
.manager__mobile-photo img { width: 100%; height: 100%; object-fit: cover; }
.manager__mobile-actions {
  flex: 1; display: flex; flex-direction: column; gap: 16px; min-width: 0;
}
.manager__mobile-actions .btn { width: 100%; justify-content: center; }
.manager__mobile-phone {
  font-family: var(--font-body); font-size: 20px; line-height: 1.5;
  color: var(--color-white); text-align: center; white-space: nowrap;
}
.manager__mobile-bio {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: rgba(255,255,255,0.55);
}

@media (max-width: 1024px) {
  .manager { padding: var(--spacing-64) var(--spacing-32); }
  .manager__header { flex-direction: column; align-items: flex-start; }
  .manager__subtitle { text-align: left; }
  .manager__content { flex-direction: column; }
  .manager__photo { width: 100%; height: 400px; }
}
@media (max-width: 760px) {
  .manager { padding: var(--spacing-24); }
  .manager__wrapper { display: none; }
  .manager__mobile { display: flex; }
}
</style>
