---
interface AdvantageItem {
  num: string;
  title: string;
  text: string;
}

interface Props {
  advantages: AdvantageItem[];
  lastAdvantage: AdvantageItem;
  title?: string;
  subtitle?: string;
  footer?: string;
}

const {
  advantages,
  lastAdvantage,
  title = "Почему выбирают нас",
  subtitle = "Семь причин, которые отличают ювелирную мастерскую от сетевого магазина. Каждая из них касается качества, которое вы будете носить каждый день.",
  footer = "Мы создаём уникальные украшения, которые соответствуют мировым стандартам. Заказывая у нас, вы можете быть уверены в высоком качестве и справедливой цене без лишних затрат.",
} = Astro.props;
---

<section class="advantages-big" id="advantages">
  <div class="advantages-big__header">
    <h2 class="advantages-big__title">{title}</h2>
    <p class="advantages-big__subtitle">{subtitle}</p>
  </div>

  <div class="advantages-big__grid">
    {advantages.map((adv) => (
      <div class="advantages-big__card">
        <div class="advantages-big__card-num">{adv.num}</div>
        <div class="advantages-big__card-content">
          <div class="advantages-big__card-title">{adv.title}</div>
          <div class="advantages-big__card-text">{adv.text}</div>
        </div>
      </div>
    ))}
    <div class="advantages-big__card advantages-big__card--last">
      <div class="advantages-big__card-num">{lastAdvantage.num}</div>
      <div class="advantages-big__card-content">
        <div class="advantages-big__card-title">{lastAdvantage.title}</div>
        <div class="advantages-big__card-text">{lastAdvantage.text}</div>
      </div>
    </div>
  </div>

  <div class="advantages-big__footer">
    <p class="advantages-big__footer-text">{footer}</p>
  </div>
</section>

<style>
.advantages-big {
  background-color: var(--color-bg-light);
  display: flex; flex-direction: column; gap: var(--spacing-64); align-items: center;
  padding: var(--spacing-64) var(--spacing-48); overflow: hidden; width: 100%;
}
.advantages-big__header {
  display: flex; align-items: center; justify-content: space-between;
  max-width: 1400px; width: 100%; gap: var(--spacing-48);
}
.advantages-big__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1; color: var(--color-dark-900); flex: 1;
}
.advantages-big__subtitle {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: var(--color-gold-900); text-align: right; flex: 1;
}
.advantages-big__grid {
  display: flex; flex-wrap: wrap; gap: var(--spacing-48); justify-content: center;
  max-width: 1400px; width: 100%;
}
.advantages-big__card {
  display: flex; gap: 39px; align-items: flex-start;
  background-color: var(--color-white); border: 1px solid var(--color-gold-600);
  padding: var(--spacing-32); flex: 1; min-width: 434px; max-width: 676px;
}
.advantages-big__card--last {
  flex-basis: 100%; max-width: 100%;
}
.advantages-big__card-num {
  font-family: var(--font-heading); font-weight: 600; font-style: italic;
  font-size: var(--font-size-h2); line-height: 1; color: var(--color-gold-600);
  white-space: nowrap; flex-shrink: 0;
}
.advantages-big__card-content {
  display: flex; flex-direction: column; gap: var(--spacing-16); flex: 1; min-width: 0;
}
.advantages-big__card-title {
  font-family: var(--font-body); font-size: var(--font-size-lg);
  font-weight: 400; line-height: 1.3; color: var(--color-dark-900);
}
.advantages-big__card-text {
  font-family: var(--font-body); font-size: var(--font-size-lg);
  line-height: 1.5; color: var(--color-text-muted);
}
.advantages-big__footer { max-width: 1400px; width: 100%; display: flex; justify-content: center; }
.advantages-big__footer-text {
  font-family: var(--font-body); font-size: var(--font-size-h6);
  line-height: 1.3; color: var(--color-dark-900); text-align: center; max-width: 750px;
}
@media (max-width: 1024px) {
  .advantages-big { padding: var(--spacing-48) var(--spacing-32); gap: var(--spacing-48); }
  .advantages-big__header { flex-direction: column; align-items: flex-start; }
  .advantages-big__subtitle { text-align: left; }
  .advantages-big__card { min-width: unset; max-width: 100%; }
  .advantages-big__card--last { max-width: 100%; }
}
@media (max-width: 500px) {
  .advantages-big { padding: var(--spacing-48) var(--spacing-24); }
  .advantages-big__title { font-size: 36px; }
  .advantages-big__card { flex-direction: column; gap: var(--spacing-16); }
  .advantages-big__card-num { font-size: 40px; }
}
</style>
