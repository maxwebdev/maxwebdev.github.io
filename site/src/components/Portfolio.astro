---
const images = [
  { src: "/images/portfolio/01.jpg", tall: false },
  { src: "/images/portfolio/02.jpg", tall: true },
  { src: "/images/portfolio/03.jpg", tall: false },
  { src: "/images/portfolio/04.jpg", tall: false },
  { src: "/images/portfolio/05.jpg", tall: false },
  { src: "/images/portfolio/06.jpg", tall: true },
  { src: "/images/portfolio/07.jpg", tall: false },
  { src: "/images/portfolio/08.jpg", tall: false },
  { src: "/images/portfolio/09.jpg", tall: false },
  { src: "/images/portfolio/10.jpg", tall: false },
];
---

<section class="portfolio" id="portfolio">
  <div class="portfolio__wrapper">
    <div class="portfolio__header">
      <h2 class="portfolio__title">Портфолио.<br/>Обручальные кольца</h2>
      <p class="portfolio__subtitle">С 2009 года — более 10 000 изделий в разных стилях и металлах. Белое золото 585, платина 950, индивидуальные комплекты.</p>
    </div>

    <div class="portfolio__grid">
      {images.map((img) => (
        <div class={`portfolio__grid-item ${img.tall ? 'portfolio__grid-item--tall' : ''}`}>
          <img src={img.src} alt="Обручальное кольцо" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="portfolio__cta">
      <a href="#manager" class="btn btn--outline">Обсудить свой дизайн</a>
    </div>
  </div>
</section>

<style>
.portfolio {
  background-color: var(--color-white);
  display: flex; flex-direction: column; align-items: center;
  padding: var(--spacing-64) var(--spacing-48);
  overflow: hidden; width: 100%;
}
.portfolio__wrapper {
  display: flex; flex-direction: column; gap: var(--spacing-64);
  max-width: 1400px; width: 100%;
}
.portfolio__header {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; gap: var(--spacing-48);
}
.portfolio__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1;
  color: var(--color-dark-900); flex: 1;
}
.portfolio__subtitle {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: var(--color-gold-900); text-align: right; flex: 1;
}
.portfolio__grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 322px; gap: var(--spacing-16);
  width: 100%;
}
.portfolio__grid-item { position: relative; overflow: hidden; }
.portfolio__grid-item img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; transition: transform var(--transition-base);
}
.portfolio__grid-item:hover img { transform: scale(1.03); }
.portfolio__grid-item--tall { grid-row: span 2; }
.portfolio__cta { display: flex; justify-content: center; }
@media (max-width: 1024px) {
  .portfolio { padding: var(--spacing-48) var(--spacing-32); }
  .portfolio__wrapper { gap: var(--spacing-48); }
  .portfolio__header { flex-direction: column; align-items: flex-start; }
  .portfolio__subtitle { text-align: left; }
  .portfolio__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 280px; }
}
@media (max-width: 500px) {
  .portfolio { padding: var(--spacing-48) var(--spacing-24); }
  .portfolio__title { font-size: 36px; }
  .portfolio__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
  .portfolio__grid-item--tall { grid-row: span 1; }
}
</style>
