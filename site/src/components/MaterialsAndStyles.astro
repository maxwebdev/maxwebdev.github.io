---
const materials = [
  { name: "Белое золото", img: "/images/material-white-gold.jpg" },
  { name: "Жёлтое золото", img: "/images/material-yellow-gold.jpg" },
  { name: "Розовое золото", img: "/images/material-rose-gold.jpg" },
  { name: "Платина", img: "/images/material-platinum.jpg" },
  { name: "Серебро", img: "/images/material-silver.jpg" },
  { name: "Бриллианты", img: "/images/material-diamonds.jpg" },
  { name: "Рубины", img: "/images/material-rubies.jpg" },
  { name: "Изумруды", img: "/images/material-emeralds.jpg" },
  { name: "Сапфиры", img: "/images/material-sapphires.jpg" },
  { name: "Бриллианты лабораторные", img: "/images/material-lab-diamonds.jpg" }
];

const styles = [
  { name: "Классический", img: "/images/style-classic.jpg" },
  { name: "Современный", img: "/images/style-modern.jpg" },
  { name: "Минимализм", img: "/images/style-minimal.jpg" },
  { name: "Тематические", img: "/images/style-thematic.jpg" }
];
---

<section class="materials" id="materials">
  <div class="materials__header">
    <h2 class="materials__title">Материал на ваш выбор</h2>
    <p class="materials__subtitle">Подлинность металлов подтверждена клеймом Пробирной палаты, на все камни — геммологические сертификаты</p>
  </div>
  <div class="materials__group">
    {materials.map((m) => (
      <div class="materials__item">
        <img src={m.img} alt={m.name} class="materials__item-image" loading="lazy" />
        <div class="materials__item-name">{m.name}</div>
      </div>
    ))}
  </div>
  <div class="materials__footer">
    <p class="materials__footer-text">Это самые популярные варианты. Мы работаем почти со всеми драгоценными металлами и подберём камень под ваш бюджет или желание.</p>
  </div>
</section>

<section class="ring-styles">
  <div class="ring-styles__header">
    <h2 class="ring-styles__title">Не знаете, какой стиль — поможем выбрать</h2>
    <p class="ring-styles__subtitle">Классика, минимализм, современный дизайн или тематические кольца — воплотим любой стиль. Покажите референс или опишите идею — мастер предложит варианты</p>
  </div>
  <div class="ring-styles__grid">
    {styles.map((s) => (
      <div class="ring-styles__item">
        <img src={s.img} alt={s.name} class="ring-styles__image" loading="lazy" />
        <div class="ring-styles__name">{s.name}</div>
      </div>
    ))}
  </div>
</section>

<style>
.materials {
  background-color: var(--color-white);
  display: flex; flex-direction: column; gap: var(--spacing-64); align-items: center;
  padding: var(--spacing-64) var(--spacing-48); overflow: hidden; width: 100%;
}
.materials__header {
  display: flex; align-items: center; justify-content: space-between;
  max-width: 1400px; width: 100%; gap: var(--spacing-48);
}
.materials__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1; color: var(--color-dark-900); flex: 1;
}
.materials__subtitle {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: var(--color-gold-900); text-align: right; flex: 1;
}
.materials__group {
  display: flex; flex-wrap: wrap; gap: var(--spacing-48);
  max-width: 1400px; width: 100%;
}
.materials__item { display: flex; gap: var(--spacing-32); align-items: center; width: 295px; }
.materials__item-image {
  width: 98px; height: 98px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
}
.materials__item-name {
  font-family: var(--font-body); font-size: var(--font-size-h6);
  line-height: 1.3; color: var(--color-dark-900); flex: 1;
}
.materials__footer { max-width: 1400px; width: 100%; display: flex; justify-content: center; }
.materials__footer-text {
  font-family: var(--font-body); font-size: var(--font-size-h6);
  line-height: 1.3; color: var(--color-dark-900); text-align: center; max-width: 750px;
}

.ring-styles {
  background-color: var(--color-bg-light);
  display: flex; flex-direction: column; gap: var(--spacing-64); align-items: center;
  padding: var(--spacing-64) var(--spacing-48); overflow: hidden; width: 100%;
}
.ring-styles__header {
  display: flex; align-items: center; justify-content: space-between;
  max-width: 1400px; width: 100%; gap: var(--spacing-48);
}
.ring-styles__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1; color: var(--color-dark-900); flex: 1;
}
.ring-styles__subtitle {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: var(--color-gold-900); text-align: right; flex: 1;
}
.ring-styles__grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  gap: var(--spacing-48); max-width: 1400px; width: 100%;
}
.ring-styles__item {
  display: flex; flex-direction: column; align-items: center;
  gap: var(--spacing-32); width: 304px;
}
.ring-styles__image {
  width: 200px; height: 200px; border-radius: 50%;
  object-fit: cover; flex-shrink: 0; transition: transform var(--transition-base);
}
.ring-styles__item:hover .ring-styles__image { transform: scale(1.04); }
.ring-styles__name {
  font-family: var(--font-body); font-size: var(--font-size-h6);
  line-height: 1.3; color: var(--color-dark-900); text-align: center; width: 100%;
}

@media (max-width: 1024px) {
  .materials { padding: var(--spacing-48) var(--spacing-32); gap: var(--spacing-48); }
  .materials__header { flex-direction: column; align-items: flex-start; }
  .materials__subtitle { text-align: left; }
  .materials__item { width: calc(50% - var(--spacing-24)); }
  .ring-styles { padding: var(--spacing-48) var(--spacing-32); gap: var(--spacing-48); }
  .ring-styles__header { flex-direction: column; align-items: flex-start; }
  .ring-styles__subtitle { text-align: left; }
  .ring-styles__grid { justify-content: center; }
  .ring-styles__item { width: 220px; }
}
@media (max-width: 500px) {
  .materials { padding: var(--spacing-48) var(--spacing-24); }
  .materials__title { font-size: 36px; }
  .materials__group { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: var(--spacing-16); row-gap: var(--spacing-48); justify-items: center; }
  .materials__item { width: auto; flex-direction: column; align-items: center; gap: var(--spacing-8); }
  .materials__item-image { width: 80px; height: 80px; }
  .materials__item-name { font-size: 14px; }
  .ring-styles { padding: var(--spacing-48) var(--spacing-24); }
  .ring-styles__title { font-size: 36px; }
  .ring-styles__grid { gap: var(--spacing-32); }
  .ring-styles__item { width: calc(50% - var(--spacing-16)); }
  .ring-styles__image { width: 140px; height: 140px; }
}
</style>
