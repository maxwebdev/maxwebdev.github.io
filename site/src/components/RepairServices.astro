---
const services = [
  { title: "Уменьшение колец",                  desc: "от 500 ₽, от 20 минут",  icon: "/icons/nav/ico_ring-reduce.svg" },
  { title: "Увеличение колец",                   desc: "от 700 ₽, от 30 минут",  icon: "/icons/nav/ico_ring-enlarge.svg" },
  { title: "Пайка цепочек, браслетов и ложек",   desc: "от 300 ₽, от 15 минут",  icon: "/icons/nav/ico_soldering.svg" },
  { title: "Лазерная пайка",                     desc: "от 500 ₽, от 20 минут",  icon: "/icons/nav/ico_soldering-laser.svg" },
  { title: "Ремонт и замена замков",              desc: "от 400 ₽, от 20 минут",  icon: "/icons/nav/ico_lock-repair.svg" },
  { title: "Закрепка камней",                    desc: "от 300 ₽, от 30 минут",  icon: "/icons/nav/ico_stone-fastening.svg" },
  { title: "Дополнительные услуги",              desc: "уточняйте у мастера",     icon: "/icons/nav/ico_drugie.svg" },
  { title: "Перевязка бус и браслетов",          desc: "от 600 ₽, от 40 минут",  icon: "/icons/nav/ico_busi.svg" },
  { title: "Родирование, золочение, серебрение", desc: "от 800 ₽, от 1 часа",    icon: "/icons/nav/ico_rodirovanie.svg" },
];
---

<section class="repair" id="repair">
  <div class="repair__wrapper">

    <div class="repair__header-card">
      <span class="repair__label">Ремонт украшений</span>
      <h2 class="repair__title">Ремонт <em>ювелирных</em> изделий</h2>
      <p class="repair__subtitle">Ремонтируем украшения с 2009 года. Качественно и с гарантией.</p>
      <a href="#manager" class="btn btn--primary">Записаться на ремонт</a>
    </div>

    <div class="repair__cards">
      {services.map((service, i) => (
        <a href="#" class={`repair__card${i === services.length - 1 && services.length % 2 !== 0 ? ' repair__card--wide' : ''}`}>
          <div class="repair__card-icon" aria-hidden="true">
            <img src={service.icon} alt="" width="56" height="56" loading="lazy" />
          </div>
          <div class="repair__card-text">
            <span class="repair__card-title">{service.title}</span>
            <span class="repair__card-desc">{service.desc}</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
.repair {
  background-color: var(--color-white);
  display: flex; flex-direction: column; align-items: center;
  padding: var(--spacing-64) var(--spacing-48); width: 100%;
}
.repair__wrapper {
  max-width: 1400px; width: 100%;
  display: flex; gap: var(--spacing-16); align-items: stretch;
}

.repair__header-card {
  flex: 0 0 calc(33.333% - var(--spacing-8));
  background-color: var(--color-dark-900);
  border-radius: var(--radius-sm);
  padding: var(--spacing-48);
  display: flex; flex-direction: column; justify-content: center;
  gap: var(--spacing-24);
}
.repair__label {
  font-family: var(--font-body); font-size: var(--font-size-sm);
  text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--color-gold-900);
}
.repair__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h2); line-height: 1.05;
  color: var(--color-gold-600);
}
.repair__title em {
  font-style: italic; color: var(--color-gold-600);
}
.repair__subtitle {
  font-family: var(--font-body); font-size: var(--font-size-base);
  line-height: 1.5; color: rgba(252, 248, 243, 0.65);
  max-width: 320px;
}

.repair__cards {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-16);
  align-content: start;
}
.repair__card {
  background-color: var(--color-bg-light);
  border: 1px solid var(--color-gold-600);
  border-radius: var(--radius-sm);
  padding: var(--spacing-24);
  display: flex; align-items: center; gap: var(--spacing-16);
  transition: transform var(--transition-base), border-color var(--transition-base);
  text-decoration: none; color: inherit;
}
.repair__card--wide {
  grid-column: 1 / -1;
}
.repair__card:hover {
  transform: translateY(-2px);
  border-color: var(--color-gold-900);
}
.repair__card-icon {
  flex-shrink: 0; width: 56px; height: 56px;
}
.repair__card-text {
  display: flex; flex-direction: column; gap: 4px;
}
.repair__card-title {
  font-family: var(--font-body); font-size: var(--font-size-lg);
  line-height: 1.35; color: var(--color-dark-900);
}
.repair__card-desc {
  font-family: var(--font-body); font-size: var(--font-size-sm);
  line-height: 1.4; color: var(--color-dark-600);
}

@media (max-width: 1024px) {
  .repair { padding: var(--spacing-48) var(--spacing-32); }
  .repair__header-card {
    flex: 0 0 38%;
    padding: var(--spacing-32);
  }
  .repair__title { font-size: var(--font-size-h3); }
  .repair__cards { grid-template-columns: 1fr; }
  .repair__card--wide { grid-column: auto; }
}
@media (max-width: 760px) {
  .repair { padding: var(--spacing-48) var(--spacing-24); }
  .repair__wrapper { flex-direction: column; }
  .repair__header-card { flex: none; padding: var(--spacing-32) var(--spacing-24); }
  .repair__title { font-size: var(--font-size-h4); }
  .repair__cards { grid-template-columns: 1fr; gap: var(--spacing-8); }
}
</style>
