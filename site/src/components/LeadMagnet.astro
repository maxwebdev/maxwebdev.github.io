<section class="cta-banner">
  <div class="cta-banner__wrapper">
    <h2 class="cta-banner__title">Узнайте стоимость ваших колец за&nbsp;30&nbsp;минут</h2>
    <p class="cta-banner__desc">Мастер рассчитает стоимость и ответит в мессенджере. Бесплатно, без обязательств.</p>
    <div class="cta-banner__button">
      <a href="#manager" class="btn btn--primary">Отправить фото мастеру</a>
    </div>
  </div>
</section>

<style>
.cta-banner {
  background-color: var(--color-white);
  display: flex; flex-direction: column; align-items: center;
  padding: var(--spacing-64) var(--spacing-48); overflow: hidden; width: 100%;
}
.cta-banner__wrapper {
  background-color: var(--color-gold-600);
  display: flex; gap: var(--spacing-48); align-items: center;
  max-width: 1400px; width: 100%;
  padding: var(--spacing-48);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.cta-banner__title {
  font-family: var(--font-heading); font-weight: 600;
  font-size: var(--font-size-h3); line-height: 1; color: var(--color-dark-900);
  flex: 1; min-width: 0;
}
.cta-banner__desc {
  font-family: var(--font-body); font-size: var(--font-size-h6);
  line-height: 1.3; color: var(--color-gold-900);
  flex: 1; min-width: 0;
}
.cta-banner__button {
  flex: 1; min-width: 0;
}
.cta-banner__button .btn {
  width: 100%;
}

@media (max-width: 1024px) {
  .cta-banner { padding: var(--spacing-48) var(--spacing-32); }
  .cta-banner__wrapper {
    flex-direction: column; align-items: flex-start;
    gap: var(--spacing-32); padding: var(--spacing-32);
  }
  .cta-banner__button { width: 100%; }
}
@media (max-width: 760px) {
  .cta-banner { padding: var(--spacing-32) var(--spacing-24); }
  .cta-banner__wrapper {
    padding: var(--spacing-24);
    border-radius: 12px;
    gap: var(--spacing-24);
  }
  .cta-banner__title { font-size: 28px; }
  .cta-banner__desc { font-size: var(--font-size-base); }
}
</style>
