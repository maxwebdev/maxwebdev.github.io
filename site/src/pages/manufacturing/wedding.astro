---
import Layout from "../../layouts/Layout.astro";
import HeaderDropdown from "../../components/HeaderDropdown.astro";
import Footer from "../../components/Footer.astro";

const portfolioImages = [
  { src: "/images/portfolio/01.jpg", alt: "Обручальные кольца с гравировкой", tall: false },
  { src: "/images/portfolio/02.jpg", alt: "Обручальные кольца из белого золота", tall: false },
  { src: "/images/portfolio/03.jpg", alt: "Кольцо с бриллиантом", tall: false },
  { src: "/images/portfolio/04.jpg", alt: "Классические обручальные кольца", tall: true },
  { src: "/images/portfolio/05.jpg", alt: "Парные кольца с гравировкой", tall: true },
  { src: "/images/portfolio/06.jpg", alt: "Кольцо из розового золота с бриллиантами", tall: false },
  { src: "/images/portfolio/07.jpg", alt: "Кольцо с сапфиром", tall: false },
  { src: "/images/portfolio/08.jpg", alt: "Современные обручальные кольца", tall: false },
  { src: "/images/portfolio/09.jpg", alt: "Кольцо с россыпью бриллиантов", tall: false },
  { src: "/images/portfolio/10.jpg", alt: "Золотые обручальные кольца", tall: true },
  { src: "/images/portfolio/11.jpg", alt: "Обручальные кольца из платины", tall: false },
  { src: "/images/portfolio/12.jpg", alt: "Обручальные кольца минимализм", tall: false },
  { src: "/images/portfolio/13.jpg", alt: "Обручальные кольца", tall: false },
];

const reviews = [
  {
    name: "Анна",
    meta: "Санкт-Петербург · Обручальные кольца парные Золото 585 проба",
    text: "Огромное спасибо ювелирам Артель. Сопроводили наш заказ на обручальные кольца от хотелок и словесных описаний до готовых изделий. Учли все пожелания. Каждую деталь, каждую мелочь. Сделали даже раньше чем мы ожидали. Ни каких переживаний перед свадьбой, что не успеем. Результат превзошёл наши ожидания. Настоящие профессионалы своего дела. Рекомендую",
    avatar: "/images/avatar-anna.svg",
  },
  {
    name: "Kseniya Luckina",
    meta: "Санкт-Петербург · Обручальные Кольца белое Золото 585 проба",
    text: "Спасибо за наши чудесные кольца. Всё изготовили в срок. Вежливые и терпеливые сотрудники",
    avatar: "/images/avatar-kseniya.svg",
  },
  {
    name: "Мария Орлова",
    meta: "Москва · Обручальные Кольца Новые с датой свадьбы",
    text: "Встретили на сайте объявление о подобных изделиях.. рискнули обратиться т.к мечтали о гравировке на обручальных кольцах.. к нам приехали на дом, померяли размерчик пальчиков.. заключили договор, внесли мы не значительную предоплату.. и стали ждать! Нам присылали несколько вариантов под наши желания на согласование в итоге получили то что хотели! Получились чудесные обручалочки, которые надеюсь не придётся снимать никогда! Спасибо мастерам за сбывшуюся мечту!",
    avatar: "/images/avatar-maria-o.svg",
  },
  {
    name: "Мария",
    meta: "Санкт-Петербург · Обручальное кольцо золото свадебное Новое",
    text: "Колечки изготовили в обозначенный срок, вежливы, отзывчивы, у нас например были необходимость сделать кольцо размером не 17, а 17,2, мы даже не догадывались что так можно (в магазинах предлагали либо 17, либо 17,5), в общем клиентоориентированы. Изделие получилось аккуратным и ажурным, но при этом надежное. Соответственно, идеально подходит для ношения всю оставшуюся жизнь. Спасибо!",
    avatar: "/images/avatar-maria.svg",
  },
];

const reasons = [
  { num: "01", title: "15 лет мастерства", text: "С 2009 года — более 10 000 украшений. Показываем производство без фильтров: от искр на верстаке до закрепки камней под микроскопом. Реальное производство, а не перекупленный товар." },
  { num: "02", title: "Собственное производство", text: "Все изделия создаются в нашей мастерской в Санкт-Петербурге. Никаких посредников, никаких скрытых наценок. Вы платите только за работу и материалы." },
  { num: "03", title: "3D-моделирование без доплат", text: "Создаём цифровую модель вашего кольца до начала производства. Вносите любые правки, пока модель вас полностью не устроит — это входит в стоимость." },
  { num: "04", title: "Гарантия пробирной палаты", text: "Все изделия проходят государственную пробирную инспекцию. Вы получаете официальное клеймо, подтверждающее подлинность и пробу металла." },
  { num: "05", title: "Индивидуальный размер", text: "Каждое кольцо создаётся под ваш размер. Если размер изменится — бесплатная корректировка в течение 1 года после получения изделия." },
  { num: "06", title: "Сертификаты на камни", text: "На все бриллианты и драгоценные камни предоставляются геммологические сертификаты с описанием характеристик. Вы знаете именно то, что покупаете." },
  { num: "07", title: "Фиксированный срок — 21 рабочий день", text: "С момента утверждения 3D-модели. Без бесконечных переносов и «скоро будет готово». Если до свадьбы меньше месяца — обсудим срочное изготовление." },
];

const metals = [
  { label: "Белое золото", img: "/images/material-white-gold.jpg" },
  { label: "Жёлтое золото", img: "/images/material-yellow-gold.jpg" },
  { label: "Розовое золото", img: "/images/material-rose-gold.jpg" },
  { label: "Платина", img: "/images/material-platinum.jpg" },
  { label: "Серебро", img: "/images/material-silver.jpg" },
];

const stones = [
  { label: "Бриллианты", img: "/images/material-diamonds.jpg" },
  { label: "Рубины", img: "/images/material-rubies.jpg" },
  { label: "Изумруды", img: "/images/material-emeralds.jpg" },
  { label: "Сапфиры", img: "/images/material-sapphires.jpg" },
  { label: "Бриллианты лабораторные", img: "/images/material-lab-diamonds.jpg" },
];

const ringStyles = [
  { label: "Классический", img: "/images/style-classic.jpg" },
  { label: "Современный", img: "/images/style-modern.jpg" },
  { label: "Минимализм", img: "/images/style-minimal.jpg" },
  { label: "Тематические", img: "/images/style-thematic.jpg" },
];

const steps = [
  { img: "/images/step-01.jpg", alt: "Обсуждение эскиза с ювелиром", title: "Вы рассказываете идею", desc: "Отправьте фото, ссылку на Pinterest, эскиз на салфетке — или просто опишите словами. Вместе с мастером подберёте металл, камни, стиль. Можно прийти в мастерскую или обсудить дистанционно." },
  { img: "/images/step-02.jpg", alt: "Создание эскиза украшения", title: "Эскиз и мерки", desc: "Создаём эскиз, учитывая все ваши пожелания. Снимаем мерки. Если вы далеко — вышлем размерное кольцо почтой. После одобрения эскиз передаётся 3D-модельеру." },
  { img: "/images/step-03.jpg", alt: "3D-моделирование кольца на компьютере", title: "3D-модель и точная стоимость", desc: "3D-модельер создаёт цифровую модель кольца. На её основе рассчитываем точную стоимость, вес и срок. Вносите любые правки — без ограничений. Производство начинается только после вашего утверждения." },
  { img: "/images/step-04.jpg", alt: "Производство кольца в ювелирной мастерской", title: "Производство", desc: "Утверждённая модель печатается на 3D-принтере (восковка), отливается в металле. Ювелиры собирают, спаивают, обрабатывают, полируют и закрепляют камни." },
  { img: "/images/step-05.jpg", alt: "Постановка государственного клейма пробирной палаты", title: "Пробирная палата", desc: "Готовое изделие отправляется в государственную Пробирную палату. Проверяется проба металла, наносится официальное клеймо." },
  { img: "/images/step-06.jpg", alt: "Вручение готового кольца клиенту", title: "Вручение", desc: "Приглашаем на примерку в мастерскую. Если вы из другого города — отправим СДЭК с полной страховкой. Вместе с кольцами вы получаете гарантию и сертификаты на камни." },
];

const prices = [
  { type: "Классические гладкие", metal: "Золото 585", price: "от 25 000 ₽" },
  { type: "С гравировкой", metal: "Золото 585", price: "от 30 000 ₽" },
  { type: "С бриллиантами", metal: "Золото 585", price: "от 45 000 ₽" },
  { type: "Классические гладкие", metal: "Платина 950", price: "от 55 000 ₽" },
  { type: "С бриллиантами", metal: "Платина 950", price: "от 75 000 ₽" },
];

const faqs = [
  { q: "Безопасно ли вносить предоплату?", a: "Да. Мы заключаем официальный договор с указанием сроков, стоимости и описания изделия. Предоплата фиксируется в договоре. Производство начинается только после вашего утверждения 3D-модели." },
  { q: "Успеете ли вы к дате моей свадьбы?", a: "Стандартный срок — 21 рабочий день с момента утверждения 3D-модели. Дата готовности фиксируется в договоре. Если до свадьбы меньше месяца — обсудим срочное изготовление. Напишите нам с датой свадьбы, и мы скажем, успеваем ли." },
  { q: "Можно заказать дистанционно из другого города?", a: "Да, около 30% наших заказов — дистанционные. Высылаем размерное кольцо почтой, все согласования проводим в мессенджере с фото и 3D-рендерами. Готовые кольца отправляем СДЭК с полной страховкой." },
  { q: "Что если размер кольца не подойдёт?", a: "Мы изготавливаем кольца с точностью до 0,1 мм (например, 17,2 — а не только стандартные 17 или 17,5, как в магазинах)." },
  { q: "Из чего складывается цена?", a: "Стоимость = металл (по биржевой цене) + камни (если есть) + работа мастера. Никаких скрытых наценок. 3D-моделирование и правки включены в стоимость. Точную цену назовём за 30 минут после получения вашего фото или эскиза." },
  { q: "Можно ли переплавить своё старое золото в обручальные кольца?", a: "Да, это одна из наших ключевых услуг. Экономия 40–60% — вы платите только за работу. Золото взвешиваем при вас, рассчитываем, достаточно ли металла. Новое изделие проходит Пробирную палату и получает государственное клеймо." },
  { q: "А что если результат мне не понравится?", a: "Мы специально создали процесс, который исключает такой риск. Вы утверждаете 3D-модель с неограниченными правками до начала производства. Вы видите будущее кольцо в деталях ещё до того, как мастер начнёт работу. Производство стартует только после вашего «да»." },
];
---

<Layout title="Обручальные кольца на заказ — Артель">
  <link rel="preload" href="/images/hero-rings.webp" as="image" type="image/webp" slot="head" />
  <meta name="description" content="Изготовление обручальных колец на заказ в Санкт-Петербурге. Собственное производство, 3D-моделирование, государственное клеймо. 21 рабочий день. С 2009 года." slot="head" />

  <HeaderDropdown />

  <main>

    <!-- ── Hero ── -->
    <section class="wr-hero" aria-labelledby="wr-hero-title">
      <div class="wr-wrap">
        <p class="wr-hero__label">
          <span>Ювелирная мастерская «Артель»</span>
          {' · '}
          <span>Санкт-Петербург</span>
          {' · '}
          <span>С 2009 года</span>
        </p>
        <div class="wr-hero__layout">
          <div class="wr-hero__texts">
            <h1 class="wr-hero__title" id="wr-hero-title">
              Обручальные кольца, созданные <em>именно для вас</em> — а не из витрины
            </h1>
            <p class="wr-hero__desc">
              Покажите нам фото, эскиз или просто расскажите идею — мы создадим кольца, которых больше ни у кого не будет. Собственное производство, 3D‑модель до начала работы, государственное клеймо.
            </p>
            <div class="wr-hero__buttons">
              <a href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20заказать%20обручальные%20кольца" class="btn btn--primary" target="_blank" rel="noopener">
                Обсудить дизайн с мастером
              </a>
              <a href="#wr-portfolio" class="btn btn--outline">Посмотреть работы</a>
            </div>
          </div>
          <div class="wr-hero__image">
            <picture>
              <source srcset="/images/hero-rings.webp" type="image/webp" />
              <img
                src="/images/hero-rings.png"
                alt="Обручальные кольца из розового золота — пример работы мастерской"
                width="600"
                height="629"
                fetchpriority="high"
                decoding="sync"
              />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Stats bar ── -->
    <section class="wr-stats" aria-label="Ключевые показатели мастерской">
      <div class="wr-wrap wr-stats__inner">
        <div class="wr-stats__item">
          <span class="wr-stats__num">15+</span>
          <span class="wr-stats__text">Лет мастерства</span>
        </div>
        <span class="wr-stats__sep" aria-hidden="true"></span>
        <div class="wr-stats__item">
          <span class="wr-stats__num">10 000+</span>
          <span class="wr-stats__text">Изделий создано</span>
        </div>
        <span class="wr-stats__sep" aria-hidden="true"></span>
        <div class="wr-stats__item">
          <span class="wr-stats__num">21 рабочий день</span>
          <span class="wr-stats__text">От эскиза до кольца</span>
        </div>
        <span class="wr-stats__sep" aria-hidden="true"></span>
        <div class="wr-stats__item">
          <span class="wr-stats__num">100%</span>
          <span class="wr-stats__text">Пробирная палата</span>
        </div>
      </div>
    </section>

    <!-- ── Portfolio ── -->
    <section class="wr-section" id="wr-portfolio" aria-labelledby="wr-portfolio-title">
      <div class="wr-wrap">
        <div class="wr-section__header">
          <h2 class="wr-section__title" id="wr-portfolio-title">
            Портфолио.<br />Обручальные кольца
          </h2>
          <p class="wr-section__subtitle">
            С 2009 года — более 10 000 изделий в разных стилях и металлах. Белое золото 585, платина 950, индивидуальные комплекты.
          </p>
        </div>
        <div class="wr-portfolio__grid">
          {portfolioImages.map((img) => (
            <div class={`wr-portfolio__item${img.tall ? " wr-portfolio__item--tall" : ""}`}>
              <img src={img.src} alt={img.alt} loading="lazy" />
            </div>
          ))}
        </div>
        <div class="wr-section__cta">
          <a href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20заказать%20обручальные%20кольца" class="btn btn--outline" target="_blank" rel="noopener">
            Обсудить дизайн с мастером
          </a>
        </div>
      </div>
    </section>

    <!-- ── Ratings ── -->
    <section class="wr-section" aria-labelledby="wr-ratings-title">
      <div class="wr-wrap">
        <div class="wr-section__header">
          <h2 class="wr-section__title" id="wr-ratings-title">5.0 на всех площадках</h2>
          <p class="wr-section__subtitle">Более 400 реальных отзывов — на Яндекс.Картах, Avito и 2ГИС. Нажмите, чтобы прочитать все</p>
        </div>
        <div class="wr-ratings">
          <a href="https://2gis.ru/spb/search/%D1%8E%D0%B2%D0%B5%D0%BB%D0%B8%D1%80%D0%BD%D0%B0%D1%8F%20%D0%BC%D0%B0%D1%81%D1%82%D0%B5%D1%80%D1%81%D0%BA%D0%B0%D1%8F%20%D0%B0%D1%80%D1%82%D0%B5%D0%BB%D1%8C/firm/70000001080478563" class="wr-rating__card" target="_blank" rel="noopener noreferrer" aria-label="5.0 — Отзывы на 2ГИС">
            <p class="wr-rating__score">5.0</p>
            <img src="/images/stars-5.svg" alt="5 звёзд из 5" width="100" height="16" />
            <img src="/images/logo-2gis.svg" alt="2ГИС" class="wr-rating__logo" loading="lazy" />
          </a>
          <a href="https://yandex.com/maps/-/CPRlvS77" class="wr-rating__card" target="_blank" rel="noopener noreferrer" aria-label="5.0 — Отзывы на Яндекс">
            <p class="wr-rating__score">5.0</p>
            <img src="/images/stars-5.svg" alt="5 звёзд из 5" width="100" height="16" />
            <img src="/images/logo-yandex.svg" alt="Яндекс" class="wr-rating__logo" loading="lazy" />
          </a>
          <a href="https://www.avito.ru/user/758e9098c95b634176cb7ddec6fd2ab5/profile/all?src=sharing" class="wr-rating__card" target="_blank" rel="noopener noreferrer" aria-label="5.0 — Отзывы на Avito">
            <p class="wr-rating__score">5.0</p>
            <img src="/images/stars-5.svg" alt="5 звёзд из 5" width="100" height="16" />
            <img src="/images/logo-avito.svg" alt="Avito" class="wr-rating__logo" loading="lazy" />
          </a>
        </div>
      </div>
    </section>

    <!-- ── Reviews ── -->
    <section class="wr-section" aria-label="Отзывы клиентов">
      <div class="wr-wrap">
        <div class="wr-reviews">
          {reviews.map((r) => (
            <article class="wr-review__card">
              <p class="wr-review__quote" aria-hidden="true">"</p>
              <p class="wr-review__text">{r.text}</p>
              <div class="wr-review__author">
                <img class="wr-review__avatar" src={r.avatar} alt="" width={42} height={42} loading="lazy" aria-hidden="true" />
                <div>
                  <p class="wr-review__name">{r.name}</p>
                  <p class="wr-review__meta">{r.meta}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA Banner ── -->
    <section class="wr-section" aria-labelledby="wr-cta-title">
      <div class="wr-wrap">
        <div class="wr-cta">
          <h2 class="wr-cta__title" id="wr-cta-title">Узнайте стоимость ваших колец за&nbsp;30&nbsp;минут</h2>
          <p class="wr-cta__desc">Отправьте фото, эскиз или ссылку на&nbsp;Pinterest — мастер рассчитает стоимость и&nbsp;ответит в&nbsp;мессенджере. Бесплатно, без обязательств.</p>
          <a href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20рассчитать%20стоимость%20обручальных%20колец" class="btn btn--primary" target="_blank" rel="noopener">
            Отправить фото мастеру
          </a>
        </div>
      </div>
    </section>

    <!-- ── Approach ── -->
    <section class="wr-section wr-section--light" aria-labelledby="wr-approach-title">
      <div class="wr-wrap">
        <div class="wr-approach">
          <div class="wr-approach__image">
            <img src="/images/approach-hand.jpg" alt="Мастер держит кольцо в руках" loading="lazy" />
          </div>
          <div class="wr-approach__content">
            <p class="wr-label">Наш подход</p>
            <h2 class="wr-section__title" id="wr-approach-title">
              Вы — соавтор.
              <em>Вместе создадим кольца, которые расскажут вашу историю</em>
            </h2>
