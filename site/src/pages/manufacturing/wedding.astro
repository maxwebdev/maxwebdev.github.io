  .wr-ratings {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-24);
  }

  .wr-rating__card {
    background: var(--color-white);
    border: 1px solid var(--color-gold-600);
    border-radius: var(--radius-sm);
    padding: var(--spacing-32);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-16);
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .wr-rating__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(199, 125, 23, 0.18);
  }

  .wr-rating__score {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    font-weight: 600;
    color: var(--color-dark-900);
    line-height: 1;
  }

  .wr-rating__logo {
    max-height: 32px;
    width: auto;
    object-fit: contain;
  }

  /* ── Reviews ── */
  .wr-reviews {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-24);
  }

  .wr-review__card {
    background: var(--color-white);
    border-top: 2px solid var(--color-gold-600);
    padding: var(--spacing-32);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .wr-review__quote {
    font-family: var(--font-heading);
    font-size: 64px;
    font-weight: 600;
    color: var(--color-gold-600);
    line-height: 0.8;
  }

  .wr-review__text {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    flex: 1;
  }

  .wr-review__author {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    margin-top: auto;
  }

  .wr-review__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .wr-review__name {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-dark-900);
    line-height: 1.3;
  }

  .wr-review__meta {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-dark-600);
    line-height: 1.4;
  }

  /* ── CTA Banner ── */
  .wr-cta {
    background: var(--color-gold-600);
    border-radius: var(--radius-lg);
    padding: var(--spacing-48);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-24);
  }

  .wr-cta__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--color-dark-900);
    line-height: 1.1;
  }

  .wr-cta__desc {
    font-family: var(--font-body);
    font-size: var(--font-size-h6);
    line-height: 1.5;
    color: var(--color-gold-900);
    max-width: 560px;
  }

  /* ── Approach ── */
  .wr-approach {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .wr-approach__image {
    height: 540px;
  }

  .wr-approach__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wr-approach__content {
    padding: var(--spacing-64);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
    justify-content: center;
  }

  .wr-approach__desc {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .wr-approach__desc p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .wr-approach__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-16);
    margin-top: var(--spacing-8);
  }

  /* ── Reasons ── */
  .wr-reasons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-24);
  }

  .wr-reason {
    background: var(--color-white);
    border: 1px solid var(--color-gold-600);
    border-radius: var(--radius-sm);
    padding: var(--spacing-32);
    display: flex;
    gap: var(--spacing-24);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .wr-reason:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(199, 125, 23, 0.18);
  }

  .wr-reason--wide { grid-column: 1 / -1; }

  .wr-reason__num {
    font-family: var(--font-heading);
    font-size: 52px;
    font-weight: 600;
    font-style: italic;
    color: var(--color-gold-600);
    line-height: 1;
    flex-shrink: 0;
  }

  .wr-reason__title {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-dark-900);
    line-height: 1.3;
    margin-bottom: var(--spacing-8);
  }

  .wr-reason__text {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .wr-reasons__footer {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 640px;
  }

  /* ── Pricing ── */
  .wr-pricing__wrap { overflow-x: auto; }

  .wr-pricing__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
  }

  .wr-pricing__table th {
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold-900);
    padding: var(--spacing-16) var(--spacing-24);
    text-align: left;
    border-bottom: 2px solid var(--color-gold-600);
  }

  .wr-pricing__table td {
    font-size: var(--font-size-base);
    color: var(--color-dark-900);
    padding: var(--spacing-16) var(--spacing-24);
    border-bottom: 1px solid var(--color-dark-300);
  }

  .wr-pricing__table tr:last-child td { border-bottom: none; }
  .wr-pricing__table tbody tr:hover td { background: var(--color-white); }

  .wr-pricing__price {
    font-family: var(--font-heading);
    font-size: var(--font-size-h4);
    font-weight: 600;
    color: var(--color-gold-900) !important;
  }

  .wr-pricing__footer {
    display: flex;
    align-items: center;
    gap: var(--spacing-32);
    flex-wrap: wrap;
  }

  .wr-pricing__note {
    flex: 1;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    min-width: 200px;
  }

  /* ── Melt ── */
  .wr-melt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .wr-melt__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
    padding-right: var(--spacing-64);
    justify-content: center;
  }

  .wr-melt__desc {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .wr-melt__steps {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
    padding-left: var(--spacing-24);
  }

  .wr-melt__steps li {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .wr-melt__quote {
    border-left: 3px solid var(--color-gold-900);
    background: rgba(255, 255, 255, 0.5);
    padding: var(--spacing-24);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .wr-melt__quote p {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-dark-900);
    line-height: 1.5;
  }

  .wr-melt__quote cite {
    display: block;
    margin-top: var(--spacing-8);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-gold-900);
    font-style: normal;
  }

  .wr-melt__image {
    height: 600px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .wr-melt__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Materials ── */
  .wr-materials__group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-32);
  }

  .wr-material {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-8);
  }

  .wr-material__img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .wr-material:hover .wr-material__img { transform: scale(1.06); }

  .wr-material__name {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-dark-900);
    text-align: center;
    line-height: 1.3;
    max-width: 88px;
  }

  .wr-materials__footer {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 560px;
  }

  /* ── Styles ── */
  .wr-styles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-24);
  }

  .wr-style {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .wr-style__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    transition: transform var(--transition-base);
  }

  .wr-style:hover .wr-style__img { transform: scale(1.03); }

  .wr-style__name {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-dark-900);
    text-align: center;
  }

  .wr-styles__footer {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 560px;
  }

  /* ── Steps ── */
  .wr-steps {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-98);
    list-style: none;
    padding: 0;
  }

  .wr-step {
    display: flex;
    align-items: center;
    gap: var(--spacing-64);
  }

  .wr-step:nth-child(even) { flex-direction: row-reverse; }

  .wr-step__img {
    width: 283px;
    height: 283px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .wr-step__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h4);
    font-weight: 600;
    color: var(--color-dark-900);
    line-height: 1.1;
    margin-bottom: var(--spacing-16);
  }

  .wr-step__desc {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 520px;
  }

  /* ── Manager ── */
  .wr-manager {
    background: var(--color-dark-900);
    padding: var(--spacing-132) var(--spacing-48);
    display: flex;
    justify-content: center;
  }

  .wr-manager__inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-48);
  }

  .wr-manager__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    font-weight: 600;
    color: var(--color-gold-600);
    line-height: 1;
  }

  .wr-manager__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: rgba(252, 248, 243, 0.7);
    line-height: 1.5;
    margin-top: var(--spacing-8);
  }

  .wr-manager__body {
    display: flex;
    gap: var(--spacing-64);
    align-items: flex-start;
  }

  .wr-manager__photo {
    width: 400px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .wr-manager__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .wr-manager__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
    padding-top: var(--spacing-16);
  }

  .wr-manager__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--color-gold-600);
    line-height: 1;
  }

  .wr-manager__name em {
    font-style: italic;
    color: var(--color-gold-600);
  }

  .wr-manager__bio {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: rgba(252, 248, 243, 0.7);
    max-width: 440px;
  }

  .wr-manager__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-16);
  }

  .wr-manager__phone {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: rgba(252, 248, 243, 0.5);
  }

  .wr-manager__phone-link {
    color: var(--color-gold-600);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .wr-manager__phone-link:hover { color: var(--color-gold-900); }

  /* ── Locations ── */
  .wr-locations {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-24);
  }

  .wr-location {
    background: var(--color-white);
    border: 1px solid var(--color-gold-600);
    border-radius: var(--radius-sm);
    padding: var(--spacing-32);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .wr-location__title {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-dark-900);
    line-height: 1.3;
  }

  .wr-location__address {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    font-style: normal;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-dark-900);
    line-height: 1.5;
  }

  .wr-location__meta {
    font-size: var(--font-size-sm);
    color: var(--color-dark-600);
  }

  .wr-location__desc {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ── FAQ ── */
  .wr-faq__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--color-dark-900);
    line-height: 1.05;
    margin-top: calc(var(--spacing-8) * -1);
    margin-bottom: var(--spacing-16);
  }

  .wr-faq {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-gold-600);
  }

  .wr-faq__item { border-bottom: 1px solid var(--color-gold-600); }

  .wr-faq__q {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: var(--spacing-24) 0;
  }

  .wr-faq__index {
    font-family: var(--font-heading);
    font-size: var(--font-size-h4);
    font-weight: 600;
    font-style: italic;
    color: var(--color-gold-600);
    line-height: 1;
    flex-shrink: 0;
    width: 44px;
    transition: color var(--transition-fast);
  }

  .wr-faq__item.is-open .wr-faq__index { color: var(--color-gold-900); }

  .wr-faq__q-text {
    flex: 1;
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-dark-900);
    line-height: 1.4;
  }

  .wr-faq__icon {
    font-size: 24px;
    color: var(--color-gold-900);
    flex-shrink: 0;
    display: inline-block;
    transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wr-faq__item.is-open .wr-faq__icon { transform: rotate(45deg); }
  .wr-faq__item.is-closing .wr-faq__icon {
    transform: rotate(0deg);
    transition: transform 0.22s ease-in;
  }

  .wr-faq__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wr-faq__item.is-open .wr-faq__a { grid-template-rows: 1fr; }
  .wr-faq__item.is-closing .wr-faq__a {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.22s ease-in;
  }

  .wr-faq__a-inner {
    overflow: hidden;
    padding-left: 60px;
    padding-bottom: 0;
    max-width: 720px;
    transition: padding-bottom 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wr-faq__item.is-open .wr-faq__a-inner { padding-bottom: var(--spacing-24); }
  .wr-faq__item.is-closing .wr-faq__a-inner {
    padding-bottom: 0;
    transition: padding-bottom 0.22s ease-in;
  }

  .wr-faq__a-inner p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  .wr-faq__item.is-open .wr-faq__a-inner p { opacity: 1; transition: opacity 0.28s ease 0.16s; }
  .wr-faq__item.is-closing .wr-faq__a-inner p { opacity: 0; transition: opacity 0.1s ease; }

  /* ── Responsive: tablet ── */
  @media (max-width: 1024px) {
    .wr-section { padding: var(--spacing-48) var(--spacing-32); }
    .wr-hero { padding: 0 var(--spacing-32); }
    .wr-stats { padding: var(--spacing-48) var(--spacing-32); }
    .wr-manager { padding: var(--spacing-64) var(--spacing-32); }

    .wr-section__header { flex-direction: column; gap: var(--spacing-16); }
    .wr-section__subtitle { text-align: left; }

    .wr-hero__layout { grid-template-columns: 1fr 1fr; min-height: 420px; }
    .wr-hero__title { font-size: var(--font-size-h2); }

    .wr-portfolio__grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 240px; }
    .wr-styles { grid-template-columns: repeat(2, 1fr); }

    .wr-approach__content { padding: var(--spacing-48); }
    .wr-melt__content { padding-right: var(--spacing-32); }

    .wr-manager__photo { width: 300px; }
    .wr-manager__body { gap: var(--spacing-48); }
  }

  /* ── Responsive: large mobile ── */
  @media (max-width: 760px) {
    .wr-section { padding: var(--spacing-32) var(--spacing-24); }
    .wr-hero { padding: 0; }
    .wr-stats { padding: var(--spacing-32) var(--spacing-24); }
    .wr-manager { padding: var(--spacing-48) var(--spacing-24); }

    .wr-hero__label { padding: var(--spacing-32) var(--spacing-24) 0; }
    .wr-hero__layout {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .wr-hero__texts {
      order: 2;
      padding: var(--spacing-24) var(--spacing-24) var(--spacing-32);
    }
    .wr-hero__image {
      order: 1;
      height: 300px;
    }
    .wr-hero__image img { max-height: 300px; }
    .wr-hero__title { font-size: var(--font-size-h3); }
    .wr-hero__buttons { flex-direction: column; }

    .wr-stats__inner { flex-wrap: wrap; gap: var(--spacing-16); justify-content: center; }
    .wr-stats__sep { display: none; }
    .wr-stats__item { flex: 0 0 auto; min-width: 120px; }

    .wr-portfolio__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; }

    .wr-ratings { grid-template-columns: 1fr; }
    .wr-reviews { grid-template-columns: 1fr; }

    .wr-cta { border-radius: 12px; padding: var(--spacing-32) var(--spacing-24); }
    .wr-cta__title { font-size: var(--font-size-h4); }
    .wr-cta__desc { font-size: var(--font-size-base); }

    .wr-approach { grid-template-columns: 1fr; }
    .wr-approach__image { height: 280px; }
    .wr-approach__content { padding: var(--spacing-32) var(--spacing-24); }
    .wr-approach__buttons { flex-direction: column; }

    .wr-reasons { grid-template-columns: 1fr; }
    .wr-reason--wide { grid-column: 1; }

    .wr-pricing__footer { flex-direction: column; align-items: flex-start; }

    .wr-melt { grid-template-columns: 1fr; }
    .wr-melt__content { padding-right: 0; }
    .wr-melt__image { height: 280px; order: -1; }

    .wr-steps { gap: var(--spacing-48); }
    .wr-step, .wr-step:nth-child(even) { flex-direction: column; }
    .wr-step__img { width: 100%; height: 240px; }

    .wr-manager__body { flex-direction: column; }
    .wr-manager__photo { width: 240px; }
