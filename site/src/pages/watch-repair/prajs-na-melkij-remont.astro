---
import InnerPage from '../../layouts/InnerPage.astro';
import StaticPriceTable from '../../components/StaticPriceTable.astro';

const watchRepairLinks = [
  { label: 'Общий ремонт часов', href: '/watch-repair/prajs-na-obshhij-remont-chasov' },
  { label: 'Мелкий ремонт',      href: '/watch-repair/prajs-na-melkij-remont' },
  { label: 'Замена батареек',    href: '/watch-repair/prajs-na-zamenu-batareek' },
  { label: 'Замена стёкол',      href: '/watch-repair/prajs-na-zamenu-stjokol' },
];

const crumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Ремонт часов', href: '/watch-repair' },
  { label: 'Прайс на мелкий ремонт' },
];

const colHeaders = ['Наименование', 'Россия', 'Импортные (кроме швейцарских)', 'Швейцария'];

const priceRows = [
  { type: 'section', label: 'Замена стекла' },
  { label: 'Пластик',                                                              cells: ['от 350 ₽',   'от 700 ₽',   'от 800 ₽'] },
  { label: 'Минеральное (кварц)',                                                  cells: ['от 650 ₽',   'от 1 200 ₽', 'от 1 700 ₽'] },
  { label: 'Сапфир',                                                               cells: ['от 3 000 ₽', 'от 3 000 ₽', 'По договорённости'] },
  { label: 'Сферические, фасонные стекла',                                         cells: ['от 500 ₽',   'от 800 ₽',   'от 1 800 ₽'] },
  { type: 'section', label: 'Замена стекла собственного изготовления' },
  { label: 'Сферические, фасонные стекла',                                         cells: ['от 1 500 ₽', 'от 1 700 ₽', 'от 3 500 ₽'] },
  { label: 'Линза',                                                                cells: ['от 2 500 ₽', 'от 3 000 ₽', 'от 4 500 ₽'] },
  { type: 'section', label: 'Ремонт' },
  { label: 'Замена заводной головки, кнопки, переводного вала (без разборки механизма)', cells: ['от 150 ₽', 'от 200 ₽', 'от 600 ₽'] },
  { label: 'Замена ушка (латунь) 10–24 мм',                                        cells: ['50 ₽',       '100 ₽',      ''] },
  { label: 'Замена ушка (нерж. сталь) 10–24 мм',                                   cells: ['100 ₽',      'от 150 ₽',   'от 200 ₽'] },
  { label: 'Ремонт, замена браслета, замка браслета',                              cells: ['от 150 ₽',   'от 300 ₽',   'от 500 ₽'] },
  { label: 'Подгонка браслета по руке (кроме керамических)',                        cells: ['от 200 ₽',   'от 350 ₽',   'от 450 ₽'] },
  { label: 'Подгонка керамических браслетов',                                       cells: ['',           'от 500 ₽',   'от 900 ₽'] },
  { label: 'Регулировка точности хода механических часов',                          cells: ['100 ₽',      'от 200 ₽',   'от 500 ₽'] },
  { label: 'Замена защитного уплотнителя',                                          cells: ['100 ₽',      'от 150 ₽',   'от 300 ₽'] },
  { label: 'Замена акрилового уплотнителя',                                         cells: ['',           '',           'от 1 000 ₽'] },
  { label: 'Замена стрелки',                                                        cells: ['от 100 ₽',   'от 200 ₽',   'от 600 ₽'] },
  { label: 'Ремонт циферблата, стрелки, установка знака',                           cells: ['от 100 ₽',   'от 200 ₽',   'от 600 ₽'] },
  { label: 'Чистка корпуса, браслета часов ультразвуком',                           cells: ['от 400 ₽',   'от 500 ₽',   'от 800 ₽'] },
  { label: 'Полировка корпуса, браслета часов',                                     cells: ['от 1 200 ₽', 'от 1 200 ₽', 'от 5 500 ₽'] },
];

const guarantees = [
  { num: '01', title: 'Гарантия 1 год',        text: 'Письменная гарантия на каждую работу. Если уплотнитель пропустит влагу, ушко отвалится или браслет вернёт прежнюю длину — переделываем бесплатно.' },
  { num: '02', title: 'Многие работы при вас', text: 'Замена ушка, подгонка браслета, замена батарейки, полировка пластикового стекла — за 10–30 минут прямо за верстаком.' },
  { num: '03', title: 'Свои сферические стёкла', text: 'Стекла нестандартной формы — сферические, фасонные, бочкообразные — вытачиваем вручную на собственном оборудовании.' },
  { num: '04', title: 'Проверка после работы',  text: 'После замены уплотнителей — обязательный тест на герметичность. После регулировки точности хода — прогон на таймграфере.' },
];

const faqs = [
  {
    q: 'Какие мелкие работы вы делаете при клиенте?',
    a: 'Замена ушка, замена заводной головки/кнопки (без разборки механизма), подгонка металлического браслета по руке, замена защитного уплотнителя, замена пластикового стекла, полировка акрилового стекла, замена батарейки — всё это часовщик делает за 10–30 минут прямо при вас. Сложные работы со вскрытием механизма требуют диагностики.',
  },
  {
    q: 'Как подгоняется браслет?',
    a: 'Для уменьшения длины металлического браслета штифты или шпильки выдавливаются строго по направлению стрелок, выгравированных на внутренней стороне звеньев. Звенья удаляем симметрично с обеих сторон, чтобы застёжка осталась ровно по центру запястья. Оптимальной считается посадка, когда между браслетом и рукой свободно проходит мизинец.',
  },
  {
    q: 'Можно ли отполировать царапины на стекле?',
    a: 'Зависит от типа стекла. Пластик (акрил) полируется легко: в мастерской — около 20 минут. Минеральное стекло тоже поддаётся полировке, и часы выглядят как новые. Сапфировое — крайне сложно из-за твёрдости 9 по шкале Мооса, нужно дорогое алмазное оборудование, чаще проще заменить. Важный нюанс: если на стекле есть антибликовое покрытие (AR), полировка его уничтожит.',
  },
  {
    q: 'Зачем менять уплотнители, если часы не текут?',
    a: 'Резиновые и силиконовые прокладки подвержены естественному износу — теряют упругость от перепадов температур, ультрафиолета и просто от времени. Менять их рекомендуется минимум раз в три года, даже если визуально всё в порядке. Иначе при первом контакте с водой (баня, бассейн, мытьё рук) внутрь попадёт влага, и начнётся коррозия.',
  },
  {
    q: 'Что такое регулировка точности хода на таймграфере?',
    a: 'Таймграфер — прибор, который анализирует звук работы механизма. У механических часов есть параметр «выкачка» (ошибка хода) — асимметрия колебаний баланса. В норме она не должна превышать 0,5 мс. Мастер сначала корректирует выкачку рычажком на мосту баланса (две линии на диаграмме сливаются в одну), затем настраивает суточную точность хода «градусником». Часы начинают идти ровно и уверенно запускаются с одного взмаха.',
  },
  {
    q: 'У меня керамический браслет, можно ли его подогнать?',
    a: 'Да, но это сложнее, чем у металлического: керамика хрупкая и требует специального инструмента. Звенья соединены пинами с винтовой фиксацией, и работа стоит дороже — от 500 ₽ для импортных часов и от 900 ₽ для швейцарских. Для российских керамических браслетов услуга не оказывается — обычно проще заказать новый.',
  },
];
---

<InnerPage
  title="Прайс на мелкий ремонт"
  description="Замена ушек, заводной головки, уплотнителей, подгонка браслета, полировка корпуса, регулировка точности хода. Многие работы выполняются прямо при клиенте."
  crumbs={crumbs}
  sidebarLinks={watchRepairLinks}
  sidebarTitle="Услуги по часам"
  activeHref="/watch-repair/prajs-na-melkij-remont"
>
  <div class="wm">

    <div class="wm__hero">
      <div class="wm__hero-content">
        <p class="wm__hero-label">Ювелирная мастерская «Артель» · Санкт-Петербург</p>
        <h1 class="wm__title">Мелкий ремонт часов</h1>
        <p class="wm__lead">
          Мы вернем вашим часам свежий вид и продлим их жизнь. Если часы
          замарались а их браслет поцарапался от времени — почистим и
          отполируем. Если браслет вам мал или велик — подгоним его, чтобы
          он идеально сидел на вашей руке. Если часы стали пропускать влагу
          и пыль — поменяем уплотнители. Если пришла в негодность какая-то
          деталь корпуса или браслета, мы восстановим её или заменим. Часы,
          которые спешат или опаздывают, мы отрегулируем до допустимой
          производителем погрешности.
        </p>
        <div class="wm__hero-cta">
          <a
            href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20сделать%20мелкий%20ремонт%20часов%2C%20отправляю%20фото"
            class="btn btn--primary"
            target="_blank"
            rel="noopener"
          >
            Прислать фото
          </a>
          <p class="wm__hero-hint">
            Многие мелкие работы делаем при вас за 10–30 минут
          </p>
        </div>
      </div>

      <div class="wm__hero-image">
        <div class="wm__hero-img-placeholder">
          <span>Фото — подгонка браслета</span>
        </div>
      </div>

      <div class="wm__hero-stats">
        <div class="wm__hero-stat">
          <span class="wm__hero-stat-num">10–30</span>
          <div class="wm__hero-stat-info">
            <span class="wm__hero-stat-unit">мин</span>
            <span class="wm__hero-stat-label">простые работы при вас</span>
          </div>
        </div>
        <span class="wm__hero-stat-sep" aria-hidden="true"></span>
        <div class="wm__hero-stat">
          <span class="wm__hero-stat-num">1</span>
          <div class="wm__hero-stat-info">
            <span class="wm__hero-stat-unit">год</span>
            <span class="wm__hero-stat-label">гарантия</span>
          </div>
        </div>
        <span class="wm__hero-stat-sep" aria-hidden="true"></span>
        <div class="wm__hero-stat">
          <span class="wm__hero-stat-num">от 50</span>
          <div class="wm__hero-stat-info">
            <span class="wm__hero-stat-unit">₽</span>
            <span class="wm__hero-stat-label">самые простые операции</span>
          </div>
        </div>
      </div>
    </div>

    <StaticPriceTable
      title="Прайс на мелкий ремонт"
      subtitle="Цены за работу без стоимости запчастей, если они требуются. Точную сумму называем сразу после осмотра — это бесплатно и ни к чему не обязывает."
      colHeaders={colHeaders}
      rows={priceRows}
      footnote="Прочерк означает, что в этой категории услуга не оказывается (например, акриловые уплотнители ставятся только на швейцарские часы)."
    />

    <!-- Виды мелких работ — карточки по деталям -->
    <div class="wm__section">
      <p class="wm__label">Что входит в мелкий ремонт</p>
      <h2 class="wm__section-title">Виды работ и нюансы</h2>
      <p class="wm__section-lead">
        Мелкий ремонт — это не одна услуга, а набор операций по корпусу,
        браслету и регулировке часов. Каждая со своими тонкостями.
      </p>
      <div class="wm__methods">
        <div class="wm__method">
          <div class="wm__method-index">01</div>
          <div class="wm__method-title">Подгонка браслета</div>
          <div class="wm__method-img"><div class="wm__card-img-placeholder"><span>Фото — звенья браслета и инструмент</span></div></div>
          <p class="wm__method-text">
            Удаляем лишние звенья симметрично с обеих сторон, чтобы застёжка
            осталась ровно по центру запястья. Штифты выдавливаем по стрелкам
            на внутренней стороне браслета — иначе можно сломать звено.
            Оптимальной считается посадка, когда между браслетом и рукой
            свободно проходит мизинец.
          </p>
        </div>
        <div class="wm__method">
          <div class="wm__method-index">02</div>
          <div class="wm__method-title">Замена ушек (спрингбаров)</div>
          <div class="wm__method-img"><div class="wm__card-img-placeholder"><span>Фото — ушко часов крупно</span></div></div>
          <p class="wm__method-text">
            Ушки удерживают браслет или ремешок на корпусе. Деформируются
            от ударов или теряются при попытке снять самостоятельно.
            Замена — от 50 ₽ за латунное и от 100 ₽ за стальное. Размеры
            подбираем под корпус от 10 до 24 мм.
          </p>
        </div>
        <div class="wm__method">
          <div class="wm__method-index">03</div>
          <div class="wm__method-title">Замена заводной головки и кнопок</div>
          <div class="wm__method-img"><div class="wm__card-img-placeholder"><span>Фото — заводная головка</span></div></div>
          <p class="wm__method-text">
            Головки и кнопки ломаются при ударах, а также могут стать причиной
            попадания воды внутрь, если их нажимать или откручивать прямо во
            время погружения. Замена без полной разборки механизма — от 150 ₽
            для российских часов и от 600 ₽ для швейцарских.
          </p>
        </div>
        <div class="wm__method">
          <div class="wm__method-index">04</div>
          <div class="wm__method-title">Замена уплотнителей</div>
          <div class="wm__method-img"><div class="wm__card-img-placeholder"><span>Фото — резиновые прокладки</span></div></div>
          <p class="wm__method-text">
            Резиновые и силиконовые прокладки подвержены естественному
            износу — теряют упругость от перепадов температур и времени.
            Для сохранения герметичности их нужно менять минимум раз в три
            года. Стандартный уплотнитель — от 100 ₽, акриловый (на швейцарских) —
            от 1 000 ₽.
          </p>
        </div>
        <div class="wm__method">
          <div class="wm__method-index">05</div>
          <div class="wm__method-title">Регулировка точности хода</div>
          <div class="wm__method-img"><div class="wm__card-img-placeholder"><span>Фото — таймграфер с диаграммой</span></div></div>
          <p class="wm__method-text">
            Ошибка хода («выкачка») — асимметрия колебаний баланса, в норме
            не более 0,5 мс. Корректируем на таймграфере, сдвигая рычаг на
            мосту баланса до тех пор, пока две линии на экране не сольются
            в одну. После этого настраиваем суточную точность «градусником».
          </p>
        </div>
        <div class="wm__method">
          <div class="wm__method-index">06</div>
          <div class="wm__method-title">Ультразвуковая чистка и полировка</div>
          <div class="wm__method-img"><div class="wm__card-img-placeholder"><span>Фото — корпус до/после</span></div></div>
          <p class="wm__method-text">
            Корпус и браслет очищаем в ультразвуковой ванне со специальной
            жидкостью — удаляются грязь и абразивные частицы из шарниров.
            Чистка — от 400 ₽. Полировка возвращает зеркальный блеск; для
            швейцарских моделей стоит от 5 500 ₽ из-за обязательной перешлифовки
            фасок и сатинированных поверхностей.
          </p>
        </div>
      </div>
    </div>

    <!-- Когда мелкий ремонт превращается в большой -->
    <div class="wm__section wm__section--warm">
      <p class="wm__label">Когда стоит насторожиться</p>
      <h2 class="wm__section-title">Симптомы, при которых мелким ремонтом не обойтись</h2>
      <p class="wm__section-lead">
        Если часы стали капризничать — мелкая работа может только замаскировать
        проблему. Лучше сразу сдать на полную диагностику.
      </p>
      <div class="wm__limits">
        <div class="wm__limit">
          <div class="wm__limit-title">Часы остановились без видимой причины</div>
          <p class="wm__limit-text">
            У кварцевых — скорее всего батарейка. У механических — это может
            быть пересохшая смазка, треснувшая пружина, износ баланса или
            попавшая внутрь пыль. Просто «заметив-завести» нельзя: проблема
            вернётся через неделю. Нужна полная диагностика.
          </p>
        </div>
        <div class="wm__limit">
          <div class="wm__limit-title">Появилась влага под стеклом</div>
          <p class="wm__limit-text">
            Если заметили конденсат — несите немедленно. Замена уплотнителя
            не спасёт, пока механизм не просушен и не очищен от коррозии.
            Морская вода особенно агрессивна и за несколько дней может
            уничтожить циферблат и баланс.
          </p>
        </div>
        <div class="wm__limit">
          <div class="wm__limit-title">Часы стали требовать частого подзавода</div>
          <p class="wm__limit-text">
            Если раньше механика держала ход 1,5–2 суток, а теперь останавливается
            за 12 часов — заводная пружина растянулась или сломан её крюк.
            Нужна замена пружины и полная переборка узла завода — это уже
            общий ремонт.
          </p>
        </div>
        <div class="wm__limit">
          <div class="wm__limit-title">Изменился звук работы</div>
          <p class="wm__limit-text">
            Если механические часы стали тикать неровно, с щелчками или
            «булькающим» звуком — это симптом удара по балансу или загрязнения
            анкера. Регулировка хода тут не поможет: нужна разборка и осмотр
            под микроскопом.
          </p>
        </div>
      </div>
    </div>

    <div class="wm__deadline">
      <div class="wm__deadline-time">
        <span class="wm__deadline-num">10–30</span>
        <span class="wm__deadline-unit">мин</span>
      </div>
      <div class="wm__deadline-divider" aria-hidden="true"></div>
      <div class="wm__deadline-body">
        <p class="wm__label">Время выполнения</p>
        <h2 class="wm__deadline-title">Многие работы — при вас</h2>
        <p class="wm__deadline-text">
          Замену ушка, заводной головки, защитного уплотнителя, подгонку
          браслета, регулировку точности хода и полировку пластикового
          стекла — мастер делает <strong>прямо при вас за 10–30 минут</strong>.
          Срок более сложных работ часовщик обозначит после диагностики, она
          занимает 3–5 дней. Во время диагностики мастер исследует, есть ли
          в часах внутренние повреждения и какие они. В среднем такой ремонт
          занимает от 2 дней.
        </p>
      </div>
    </div>

    <div class="wm__section">
      <p class="wm__label">Обязательства</p>
      <h2 class="wm__section-title">Наши гарантии</h2>
      <div class="wm__guarantees">
        {guarantees.map((g) => (
          <div class="wm__guarantee">
            <div class="wm__guarantee-num">{g.num}</div>
            <div class="wm__guarantee-title">{g.title}</div>
            <div class="wm__guarantee-text">{g.text}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="wm__section">
      <p class="wm__label">Вопросы и ответы</p>
      <h2 class="wm__section-title">Частые вопросы</h2>
      <div class="wm__faq">
        {faqs.map((item, i) => (
          <div class="wm__faq-item">
            <button class="wm__faq-q" type="button" aria-expanded="false" aria-controls={`faq-panel-${i}`}>
              <span class="wm__faq-q-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="wm__faq-q-text">{item.q}</span>
              <span class="wm__faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="wm__faq-a" id={`faq-panel-${i}`} role="region">
              <div class="wm__faq-a-inner"><p>{item.a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</InnerPage>

<script>
  document.querySelectorAll<HTMLElement>('.wm__faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.wm__faq-q')!;
    const answer = item.querySelector<HTMLElement>('.wm__faq-a')!;
    btn.addEventListener('click', () => {
      if (item.classList.contains('is-open')) {
        item.classList.add('is-closing');
        item.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        answer.addEventListener('transitionend', () => { item.classList.remove('is-closing'); }, { once: true });
      } else {
        item.classList.remove('is-closing');
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

