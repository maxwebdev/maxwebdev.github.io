---
import InnerPage from '../../layouts/InnerPage.astro';
import StaticPriceTable from '../../components/StaticPriceTable.astro';

const watchRepairLinks = [
  { label: 'Общий ремонт часов', href: '/watch-repair/prajs-na-obshhij-remont-chasov' },
  { label: 'Мелкий ремонт',      href: '/watch-repair/prajs-na-melkij-remont' },
  { label: 'Замена батареек',    href: '/watch-repair/prajs-na-zamenu-batareek' },
  { label: 'Замена стёкол',      href: '/watch-repair/prajs-na-zamenu-stjokol' },
];

const crumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Ремонт часов', href: '/watch-repair' },
  { label: 'Прайс на общий ремонт часов' },
];

const colHeaders = ['Наименование', 'Россия', 'Импортные (кроме швейцарских)', 'Швейцария'];

const mechanicalRows = [
  { type: 'section', label: 'Наручные' },
  { label: 'без календаря',                       cells: ['от 600 ₽',  'от 700 ₽',  'от 1 500 ₽'] },
  { label: 'простой календарь',                    cells: ['от 800 ₽',  'от 1 500 ₽','от 2 150 ₽'] },
  { label: 'с автоподзаводом',                     cells: ['от 900 ₽',  'от 1 250 ₽','от 2 550 ₽'] },
  { label: 'хронографы',                           cells: ['от 1 800 ₽','от 6 000 ₽','от 8 000 ₽'] },
  { label: 'в золотом, серебряных корпусах',       cells: ['от 1 500 ₽','от 2 500 ₽','от 4 500 ₽'] },
  { type: 'section', label: 'Настольные и настенные' },
  { label: 'без боя',                              cells: ['от 700 ₽',  'от 1 500 ₽','от 3 500 ₽'] },
  { label: 'с боем',                               cells: ['от 1 200 ₽','от 3 000 ₽','от 5 000 ₽'] },
  { label: 'с «Кукушкой»',                         cells: ['от 1 500 ₽','По договорённости','По договорённости'] },
  { label: 'с четвертичным боем',                  cells: ['от 6 000 ₽','По договорённости','По договорённости'] },
  { type: 'section', label: 'Будильники и прочие' },
  { label: 'Будильники',                           cells: ['от 400 ₽',  'от 700 ₽',  'от 1 500 ₽'] },
  { label: 'Минибудильники',                       cells: ['от 600 ₽',  'от 1 000 ₽','от 1 800 ₽'] },
  { label: 'Карманные',                            cells: ['от 600 ₽',  'По договорённости','По договорённости'] },
  { label: 'Секундомеры',                          cells: ['от 900 ₽',  'По договорённости','По договорённости'] },
  { label: 'Антикварные',                          cells: ['от 3 000 ₽','от 3 000 ₽','от 3 000 ₽'] },
];

const quartzRows = [
  { type: 'section', label: 'Наручные' },
  { label: 'без календаря',                        cells: ['от 500 ₽',  'от 800 ₽',  'от 1 500 ₽'] },
  { label: 'простой календарь',                     cells: ['от 600 ₽',  'от 1 000 ₽','от 2 000 ₽'] },
  { label: 'сложный календарь, мультифункции',      cells: ['от 800 ₽',  'от 1 500 ₽','от 3 500 ₽'] },
  { label: 'хронограф',                             cells: ['от 2 800 ₽','от 3 500 ₽','от 6 000 ₽'] },
  { label: 'в золотом, серебряном корпусе',         cells: ['от 1 200 ₽','от 2 500 ₽','от 3 500 ₽'] },
  { label: 'аккумулятор, конденсатор, автокварц',   cells: ['',          'от 3 000 ₽','от 4 500 ₽'] },
  { type: 'section', label: 'Настольные и настенные' },
  { label: 'Настольные, настенные, будильники',     cells: ['от 500 ₽',  'от 800 ₽',  'от 3 000 ₽'] },
  { type: 'section', label: 'Замена механизма' },
  { label: 'наручные',                              cells: ['от 500 ₽',  'от 500 ₽',  'от 800 ₽'] },
  { label: 'настольные, настенные, будильники',     cells: ['от 500 ₽',  'от 800 ₽',  'от 800 ₽'] },
];

const guarantees = [
  {
    num: '01',
    title: 'Гарантия 1 год',
    text: 'Выдаём письменную гарантию на каждую работу по ремонту механизма — от полной переборки до настройки точности хода.',
  },
  {
    num: '02',
    title: 'Часовщики с образованием',
    text: 'Профильное образование и стаж от 8 до 40 лет. Работаем с любыми механизмами — российскими, японскими, швейцарскими и редкими калибрами.',
  },
  {
    num: '03',
    title: 'Регулировка на таймграфере',
    text: 'После сборки настраиваем «выкачку» и точность хода на приборе. Ошибка хода в норме — до 0,5 мс. Часы идут устойчиво при любом положении.',
  },
  {
    num: '04',
    title: 'Проверка перед выдачей',
    text: 'Контрольный прогон механизма, проверка корпуса и герметичности. Возвращаем часы с детальной описью того, что было сделано.',
  },
];

const faqs = [
  {
    q: 'По каким причинам часы могут внезапно остановиться?',
    a: 'У кварцевых самая частая причина — разрядка батарейки. У механических — естественный износ деталей, пересыхание смазки или попадание внутрь влаги и пыли. Загрязнение механизма приводит к тому, что часы сначала начинают отставать, спешить или останавливаются. Точную причину покажет диагностика 3–5 дней.',
  },
  {
    q: 'Что значит «пересохла смазка» и почему её нужно менять?',
    a: 'Часовая смазка с годами теряет вязкость и испаряется — трение в опорах баланса и колёсной системе возрастает, амплитуда хода падает, часы начинают останавливаться при малейшем перекосе. Поэтому полный сервис механических часов («репассаж») рекомендуется раз в 5–7 лет: разборка, чистка ультразвуком, новая смазка по точкам, сборка.',
  },
  {
    q: 'Сколько занимает диагностика и сам ремонт?',
    a: 'Срок ремонта часовщик обозначит после проведения диагностики, она занимает 3–5 дней. Во время диагностики мастер исследует, есть ли в часах внутренние повреждения и какие они. В среднем ремонт занимает от 2 дней. Если требуется заказ редких запчастей — сообщим заранее, до начала работы.',
  },
  {
    q: 'Можно ли отремонтировать антикварные часы?',
    a: 'Да. Принцип реставрации старинных часов — минимальное вмешательство и максимальное сохранение оригинального исторического механизма. Заводских запчастей на антиквариат давно не выпускают, поэтому недостающие детали вытачиваем вручную. Восстановление затрагивает и внешний вид: устраняем сколы на эмалевых циферблатах, восстанавливаем позолоту гальваническим методом, реставрируем деревянную резьбу корпуса.',
  },
  {
    q: 'Возьмётесь ли вы за швейцарские часы (Tissot, Tag Heuer, Longines, Breitling)?',
    a: 'Да, опыт у часовщиков большой, в том числе с премиум-классом и моделями с усложнениями: хронографами, фазами луны, вечными календарями. Перед началом работы проверим серийный номер и подскажем, не лучше ли в вашем случае обратиться в авторизованный фирменный сервис — например, если на часы ещё действует заводская гарантия (вскрытие у нас её аннулирует).',
  },
  {
    q: 'Сохранится ли водонепроницаемость после ремонта?',
    a: 'Да, если ремонт выполняется профессионально. В процессе обслуживания мы восстанавливаем герметичность путём замены резиновых уплотнителей под крышку, стекло и заводную головку. После сборки проводим обязательную проверку на герметичность двумя методами: «сухим» вакуумным тестом на приборе WITSCHI и «мокрым» — погружением в жидкость на BERGEON 5555. Резиновые прокладки в любом случае рекомендуется менять минимум раз в три года.',
  },
  {
    q: 'Что делать, если часы намокли — попали в море или в стиралку?',
    a: 'Несите как можно скорее, желательно в тот же день. Влага — особенно агрессивная морская вода — моментально запускает коррозию, которая разрушает механизм, циферблат и стрелки. Если откладывать ремонт, цена восстановления может сравняться со стоимостью новых часов. Сначала часы отдают на просушку в специальной среде, потом разбирают, чистят, меняют пострадавшие детали и восстанавливают герметичность.',
  },
];
---

<InnerPage
  title="Прайс на общий ремонт часов"
  description="Полная диагностика и ремонт механических и кварцевых часов в Санкт-Петербурге — наручных, настольных, настенных, антикварных. Гарантия 1 год."
  crumbs={crumbs}
  sidebarLinks={watchRepairLinks}
  sidebarTitle="Услуги по часам"
  activeHref="/watch-repair/prajs-na-obshhij-remont-chasov"
>
  <div class="wo">

    <!-- ── Hero ── -->
    <div class="wo__hero">
      <div class="wo__hero-content">
        <p class="wo__hero-label">
          Ювелирная мастерская «Артель» · Санкт-Петербург
        </p>
        <h1 class="wo__title">Общий ремонт часов</h1>
        <p class="wo__lead">
          В часовую мастерскую Artel вы можете прийти по разным причинам.
          Если часы встали, а причина не в севшей батарейке. Если механические
          часы перестали держать завод, как раньше, а может они постоянно
          спешат или отстают.
        </p>
        <p class="wo__lead">
          Наши мастера проведут диагностику ваших часов, выяснят в чём причина
          неполадок и устранят их. Мы найдем подход ко всем видам часов:
          от наручных и будильников — до больших напольных часов, от современных —
          до раритетных из позапрошлого века, от заказанных на «Алиэкспресс» —
          до дорогих брендовых.
        </p>
        <div class="wo__hero-cta">
          <a
            href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20отдать%20часы%20в%20общий%20ремонт%2C%20отправляю%20фото"
            class="btn btn--primary"
            target="_blank"
            rel="noopener"
          >
            Прислать фото часов
          </a>
          <p class="wo__hero-hint">
            Ответим в течение нескольких минут и согласуем диагностику
          </p>
        </div>
      </div>

      <div class="wo__hero-image">
        <div class="wo__hero-img-placeholder">
          <span>Фото — разборка механизма</span>
        </div>
      </div>

      <div class="wo__hero-stats">
        <div class="wo__hero-stat">
          <span class="wo__hero-stat-num">3–5</span>
          <div class="wo__hero-stat-info">
            <span class="wo__hero-stat-unit">дней</span>
            <span class="wo__hero-stat-label">диагностика</span>
          </div>
        </div>
        <span class="wo__hero-stat-sep" aria-hidden="true"></span>
        <div class="wo__hero-stat">
          <span class="wo__hero-stat-num">1</span>
          <div class="wo__hero-stat-info">
            <span class="wo__hero-stat-unit">год</span>
            <span class="wo__hero-stat-label">гарантия на работу</span>
          </div>
        </div>
        <span class="wo__hero-stat-sep" aria-hidden="true"></span>
        <div class="wo__hero-stat">
          <span class="wo__hero-stat-num">0,5</span>
          <div class="wo__hero-stat-info">
            <span class="wo__hero-stat-unit">мс</span>
            <span class="wo__hero-stat-label">точность хода</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Цены: механические часы ── -->
    <StaticPriceTable
      title="Механические часы"
      subtitle="Цены за полный ремонт механизма: разборка, чистка, смазка, сборка, настройка точности хода. Без стоимости запчастей, если они требуются."
      colHeaders={colHeaders}
      rows={mechanicalRows}
      footnote="Точную стоимость называем после диагностики (3–5 дней). Срочные работы и редкие калибры — отдельно по договорённости."
    />

    <!-- ── Цены: кварцевые часы ── -->
    <StaticPriceTable
      title="Кварцевые часы"
      subtitle="Ремонт электронной части, чистка корпуса, замена шестерён, регулировка стрелочной системы. Замена самого механизма — отдельной строкой."
      colHeaders={colHeaders}
      rows={quartzRows}
      footnote="Если батарейка протекла и повредила механизм — оцениваем дополнительно. Цена замены платы зависит от модели."
    />

    <!-- ── От чего зависит цена ── -->
    <div class="wo__section">
      <p class="wo__label">Стоимость работы</p>
      <h2 class="wo__section-title">От чего зависит цена ремонта</h2>
      <p class="wo__section-lead">
        Полный «общий ремонт» — это не одна операция, а цепочка из 4–6 шагов.
        Цена складывается из сложности механизма, происхождения часов, наличия
        усложнений и состояния корпуса.
      </p>
      <div class="wo__cases">
        <div class="wo__case">
          <span class="wo__case-num">01</span>
          <div class="wo__case-title">Тип механизма</div>
          <p class="wo__case-text">
            Простой механический калибр без календаря — самая дешёвая работа.
            Хронограф с автоподзаводом — на порядок дороже: больше шестерён,
            рычагов, точек смазки и каскадов сцепления. У кварцевых начальная
            цена ниже, но при повреждении платы стоимость растёт.
          </p>
        </div>
        <div class="wo__case">
          <span class="wo__case-num">02</span>
          <div class="wo__case-title">Происхождение часов</div>
          <p class="wo__case-text">
            Российский ширпотреб ремонтируется быстрее и дешевле — детали взаимозаменяемы,
            запчасти доступны. Импортный масс-маркет — средняя категория. Швейцария —
            самая дорогая: оригинальные запчасти заказываются от поставщика,
            работа выполняется под микроскопом по фирменным регламентам.
          </p>
        </div>
        <div class="wo__case">
          <span class="wo__case-num">03</span>
          <div class="wo__case-title">Усложнения</div>
          <p class="wo__case-text">
            Календарь, секундомер, GMT, автоподзавод, репетир, фазы луны —
            каждое усложнение добавляет узел, который нужно отдельно разобрать,
            почистить, смазать и проверить. Цена растёт пропорционально количеству
            функций, которые часы умеют.
          </p>
        </div>
        <div class="wo__case">
          <span class="wo__case-num">04</span>
          <div class="wo__case-title">Замена запчастей</div>
          <p class="wo__case-text">
            Если износ деталей превысил норму — нужны новые: пружина баланса,
            анкерная вилка, заводная пружина. Их стоимость считается отдельно.
            На антиквариат запчастей нет в природе: ось баланса, шестерню или
            винт мастер вытачивает вручную, что увеличивает срок и цену.
          </p>
        </div>
        <div class="wo__case">
          <span class="wo__case-num">05</span>
          <div class="wo__case-title">Корпус и герметичность</div>
          <p class="wo__case-text">
            Полировка корпуса, замена уплотнителей, восстановление гидроизоляции,
            тестирование на герметичность — это отдельные операции. Для дайверских
            и пилотских часов они обязательны, для повседневных моделей делаются
            по запросу. Прокладки рекомендуем менять минимум раз в три года.
          </p>
        </div>
        <div class="wo__case">
          <span class="wo__case-num">06</span>
          <div class="wo__case-title">Срочность</div>
          <p class="wo__case-text">
            Стандартный срок — 2 дня после диагностики, если запчасти есть на
            складе. Если нужно срочно (например, к свадьбе или подарку) —
            можем сделать быстрее за отдельную плату. Заказ редких деталей —
            до 45 дней, как разрешает закон о защите прав потребителей.
          </p>
        </div>
      </div>
    </div>

    <!-- ── Что входит в полный сервис ── -->
    <div class="wo__section wo__section--warm">
      <p class="wo__label">Что входит в полный сервис</p>
      <h2 class="wo__section-title">7 этапов «общего ремонта»</h2>
      <p class="wo__section-lead">
        Полный профессиональный сервис («репассаж») — это не одна процедура,
        а комплекс. Если часовщик называет очень низкую цену, скорее всего,
        он делает только часть работ. Ниже — что должно входить в нормальный
        полный ремонт.
      </p>
      <div class="wo__methods">
        <div class="wo__method">
          <div class="wo__method-index">01</div>
          <div class="wo__method-title">Разборка под микроскопом</div>
          <p class="wo__method-text">
            Механизм аккуратно разбирается на отдельные детали — мост баланса,
            анкер, колёсная система, заводной узел. Каждая деталь осматривается
            на предмет износа, трещин, следов коррозии.
          </p>
        </div>
        <div class="wo__method">
          <div class="wo__method-index">02</div>
          <div class="wo__method-title">Ультразвуковая чистка</div>
          <p class="wo__method-text">
            Детали моются в ультразвуковой ванне со специальной жидкостью.
            Удаляются старая смазка, металлическая пыль и грязь из подшипниковых
            гнёзд. Корпус и браслет — отдельно, в другой ванне.
          </p>
        </div>
        <div class="wo__method">
          <div class="wo__method-index">03</div>
          <div class="wo__method-title">Изготовление запчастей</div>
          <p class="wo__method-text">
            Если износ детали превысил норму, её меняют. Для антикварных и
            редких калибров недостающие шестерни, оси и винты вытачиваем вручную.
            Это самая трудоёмкая часть работы.
          </p>
        </div>
        <div class="wo__method">
          <div class="wo__method-index">04</div>
          <div class="wo__method-title">Смазка по точкам</div>
          <p class="wo__method-text">
            В часовом механизме около 15 точек смазки, и для каждой нужно
            подходящее масло — общее, для опор баланса, для триба, для
            ходовой пружины. Излишек масла так же вреден, как и его нехватка.
          </p>
        </div>
        <div class="wo__method">
          <div class="wo__method-index">05</div>
          <div class="wo__method-title">Сборка и контроль</div>
          <p class="wo__method-text">
            Механизм собирается обратно в обратной последовательности.
            После сборки часовщик проверяет, что баланс свободно качается,
            анкерная вилка стоит ровно между ограничителями, заводной узел
            крутит без рывков.
          </p>
        </div>
        <div class="wo__method">
          <div class="wo__method-index">06</div>
          <div class="wo__method-title">Регулировка на таймграфере</div>
          <p class="wo__method-text">
            Часы ставятся на таймграфер. Сначала рычажком «выкачки» добиваются
            симметричности колебаний баланса — на экране две линии сливаются
            в одну. Затем «градусником» настраивается суточная точность хода.
            В норме ошибка хода — до 0,5 мс.
          </p>
        </div>
        <div class="wo__method">
          <div class="wo__method-index">07</div>
          <div class="wo__method-title">Проверка герметичности</div>
          <p class="wo__method-text">
            Для водонепроницаемых моделей — обязательная финальная процедура.
            «Сухой» тест в WITSCHI: давление меняется, прибор замеряет деформацию
            корпуса. Если корпус герметичен, проходит и «мокрый» тест в BERGEON 5555.
          </p>
        </div>
      </div>
    </div>

    <!-- ── Сроки ── -->
    <div class="wo__deadline">
      <div class="wo__deadline-time">
        <span class="wo__deadline-num">3–5</span>
        <span class="wo__deadline-unit">дней</span>
      </div>
      <div class="wo__deadline-divider" aria-hidden="true"></div>
