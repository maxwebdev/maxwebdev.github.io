---
import InnerPage from "../../layouts/InnerPage.astro";
import SanityPriceTable from "../../components/SanityPriceTable.astro";

const repairLinks = [
  { label: "Уменьшение колец", href: "/repair/umenshenie-kolecz" },
  { label: "Увеличение колец", href: "/repair/uvelichenie-kolecz" },
  {
    label: "Пайка цепочек и браслетов",
    href: "/repair/pajka-cepochek-brasletov-i-lozhek",
  },
  { label: "Лазерная пайка", href: "/repair/lazernaja-pajka" },
  { label: "Ремонт и замена замков", href: "/repair/remont-i-zamena-zamkov" },
  { label: "Закрепка камней", href: "/repair/zakrepka-kamnej" },
  { label: "Перевязка бус", href: "/repair/perevjazka-bus-i-brasletov" },
  {
    label: "Родирование, золочение",
    href: "/repair/rodirovanie-zolochenie-serebrenie",
  },
  { label: "Дополнительные услуги", href: "/repair/dopolnitelnye-uslugi" },
];

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Ремонт украшений", href: "/repair" },
  { label: "Родирование, золочение, серебрение" },
];

const guarantees = [
  {
    num: "01",
    title: "Гарантия 1 год",
    text: "Выдаём письменную гарантию на каждое изделие.",
  },
  {
    num: "02",
    title: "Мастера с образованием",
    text: "Все ювелиры с высшим профильным образованием. Стаж — от 8 до 40 лет.",
  },
  {
    num: "03",
    title: "Камни и эмаль в безопасности",
    text: "Закрываем вставки, эмаль и чернение защитным лаком перед процедурой. Ничто не пострадает.",
  },
  {
    num: "04",
    title: "Проверка перед выдачей",
    text: "Проверяем равномерность и блеск покрытия. Получаете украшение как новое.",
  },
];

const faqs = [
  {
    q: "Можно ли родировать украшение с камнями?",
    a: "Да. Большинство камней — бриллианты, фианиты, топазы, сапфиры, рубины, изумруды — процедуру переносят нормально. Перед родированием мастер закрывает их специальным лаком. Исключение — камни с карбонатной структурой: малахит, бирюза, жемчуг, перламутр. Они боятся кислот. Если такой камень нельзя закрыть лаком, мастер вынет его, проведёт покрытие и вставит обратно. Это увеличивает стоимость, но результат будет правильным.",
  },
  {
    q: "Сколько держится родирование на обручальном кольце?",
    a: "При ежедневной носке — 2–3 года. Если снимаете кольцо на ночь и перед физической работой — 5–7 лет. Срок зависит от того, насколько активно кольцо контактирует с поверхностями: руль автомобиля, ключи, соседние украшения.",
  },
  {
    q: "Можно ли изменить цвет украшения при родировании?",
    a: "Да. Серебряное кольцо можем покрыть жёлтым или красным золотом. Золотое украшение — белым родием. Можно сделать чёрное родирование для контрастного эффекта. Если нужно изменить цвет только части украшения — закрываем остальные фрагменты лаком и работаем прицельно.",
  },
  {
    q: "Что такое чёрное родирование?",
    a: "Покрытие чёрным родием — специальный вид гальваники, который даёт матово-угольный или зеркально-чёрный эффект. Популярно для мужских украшений, изделий в стиле готики или винтажа. Стойкость чёрного родия немного ниже белого — тонкий слой, зато крайне эффектный вид.",
  },
  {
    q: "Родированное серебро — это то же самое, что белое золото?",
    a: "Внешне — да. Оба металла после родирования дают идентичный холодный серебристый блеск. Визуально их не отличить. Разница в металле основы: серебро 925 пробы легче и дешевле. Без родирования само по себе белое золото имеет лёгкий желтоватый оттенок — именно родий придаёт ему «платиновый» вид.",
  },
  {
    q: "Можно ли родировать изделия из латуни или меди?",
    a: "Да, но потребуется дополнительный шаг. Латунь и медь плохо держат родий и золото — нужен промежуточный слой серебра или никеля. Без него позолота сойдёт за несколько дней. С промежуточным слоем покрытие держится как на драгоценном металле.",
  },
  {
    q: "Как часто нужно обновлять родирование?",
    a: "Зависит от типа украшения. Кольца при активной носке — раз в 1–2 года. Серьги и кулоны — раз в 3–5 лет или по необходимости. Признак того, что пора: серебро потемнело, на белом золоте проступил желтоватый оттенок, украшение потеряло блеск или видны царапины.",
  },
];

const processSteps = [
  {
    num: "01",
    title: "Подготовка изделия",
    text: "Мастер осматривает украшение, удаляет старое покрытие (если нужно), шлифует и полирует поверхность. Это важный этап: если на металле остались царапины — родий их не скроет, а подчеркнёт.",
  },
  {
    num: "02",
    title: "Защита элементов",
    text: "Камни, эмаль, чернение и фрагменты, которые не нужно покрывать, закрываем специальным лаком. Он защищает их от воздействия химических растворов.",
  },
  {
    num: "03",
    title: "Обезжиривание и активация",
    text: "Украшение погружаем в раствор для удаления жировых следов, потом в слабую кислоту на несколько секунд — для лучшего сцепления металлов.",
  },
  {
    num: "04",
    title: "Гальваническое покрытие",
    text: "Изделие опускаем в ванну с раствором солей родия, золота или серебра. Подключаем электрический ток: атомы драгоценного металла равномерно оседают на поверхности. Толщина покрытия для кольца — 0,75–1 мкм, для серёг — 0,1–0,25 мкм. Делать слой толще нельзя — из-за твёрдости родия он начнёт трескаться.",
  },
  {
    num: "05",
    title: "Финишная обработка",
    text: "Снимаем защитный лак, промываем украшение в дистиллированной воде, сушим и проверяем качество покрытия.",
  },
];
---

<InnerPage
  title="Родирование, золочение, серебрение"
  description="Родирование, золочение и серебрение в Санкт-Петербурге. Обновим покрытие колец, серёг, цепочек. Гладкое кольцо — за 1 час. Гарантия 1 год."
  crumbs={crumbs}
  sidebarLinks={repairLinks}
  sidebarTitle="Услуги ремонта"
  activeHref="/repair/rodirovanie-zolochenie-serebrenie"
>
  <div class="rg">

    <!-- ── Hero ── -->
    <div class="rg__hero">
      <div class="rg__hero-content">
        <p class="rg__hero-label">
          Ювелирная мастерская «Артель» · Санкт-Петербург
        </p>
        <h1 class="rg__title">Родирование, золочение, серебрение</h1>
        <p class="rg__lead">
          Родирование, золочение и серебрение — это гальваническое покрытие
          ювелирных изделий защитным слоем металла. Восстановим покрытие
          украшений: кольца, серьги и цепочки будут блестеть как новые.
          Работаем с серебром, золотом, платиной и белым золотом.
        </p>
        <div class="rg__hero-cta">
          <a
            href="https://wa.me/+79319616090?text=Здравствуйте%2C%20хочу%20родировать%20украшение%2C%20отправляю%20фото"
            class="btn btn--primary"
            target="_blank"
            rel="noopener"
          >
            Прислать фото украшения
          </a>
          <p class="rg__hero-hint">
            Рассчитаем стоимость за 10 минут
          </p>
        </div>
      </div>

      <div class="rg__hero-image">
        <div class="rg__hero-img-placeholder">
          <span>Фото — мастер наносит гальваническое покрытие на кольцо</span>
        </div>
      </div>

      <div class="rg__hero-stats">
        <div class="rg__hero-stat">
          <span class="rg__hero-stat-num">1</span>
          <div class="rg__hero-stat-info">
            <span class="rg__hero-stat-unit">час</span>
            <span class="rg__hero-stat-label">на гладкое кольцо</span>
          </div>
        </div>
        <span class="rg__hero-stat-sep" aria-hidden="true"></span>
        <div class="rg__hero-stat">
          <span class="rg__hero-stat-num">1</span>
          <div class="rg__hero-stat-info">
            <span class="rg__hero-stat-unit">год</span>
            <span class="rg__hero-stat-label">гарантия на работу</span>
          </div>
        </div>
        <span class="rg__hero-stat-sep" aria-hidden="true"></span>
        <div class="rg__hero-stat">
          <span class="rg__hero-stat-num">8–40</span>
          <div class="rg__hero-stat-info">
            <span class="rg__hero-stat-unit">лет</span>
            <span class="rg__hero-stat-label">стаж мастеров</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Почему темнеет / желтеет ── -->
    <div class="rg__section rg__section--warm">
      <p class="rg__label">Зачем нужно покрытие</p>
      <h2 class="rg__section-title">Почему темнеет серебро и желтеет белое золото</h2>
      <div class="rg__reasons">
        <div class="rg__reason">
          <div class="rg__reason-title">Серебро темнеет</div>
          <p class="rg__reason-text">
            Из-за реакции с сероводородом в воздухе и на коже. В ювелирных
            сплавах 925 пробы содержится 7,5% меди — она окисляется быстрее
            серебра и усиливает потемнение. Украшение покрывается тёмным налётом
            за несколько месяцев.
          </p>
        </div>
        <div class="rg__reason">
          <div class="rg__reason-title">Белое золото желтеет</div>
          <p class="rg__reason-text">
            Потому что родиевое покрытие стирается от трения. Кольцо царапается
            о руль машины, ключи в кармане, соседние украшения. За 2–3 года
            активной носки защитный слой стирается, и проступает желтоватый
            оттенок золотого сплава.
          </p>
        </div>
        <div class="rg__reason rg__reason--solution">
          <div class="rg__reason-title">Решение</div>
          <p class="rg__reason-text">
            Родирование создаёт защитный барьер между металлом и агрессивной
            средой. Серебро не темнеет, белое золото сохраняет холодный блеск
            3–5 лет. Родий — драгоценный металл платиновой группы, в 7–10 раз
            дороже золота и в 2,5 раза тверже. Мировые бренды — Tiffany&nbsp;&amp;&nbsp;Co,
            Dior, Gucci — используют родирование для серебряных коллекций.
          </p>
        </div>
      </div>
    </div>

    <!-- ── Prices ── -->
    <SanityPriceTable slug="repair-plating" />

    <!-- ── Виды покрытий ── -->
    <div class="rg__section">
      <p class="rg__label">Варианты</p>
      <h2 class="rg__section-title">Какого цвета можно сделать покрытие</h2>
      <p class="rg__section-lead">
        Гальваника меняет не только состояние, но и цвет украшения. Вы можете
        обновить родной вид или полностью переделать украшение.
      </p>
      <div class="rg__cases">
        <div class="rg__case">
          <div class="rg__card-img">
            <span>Фото — кольцо до и после белого родирования</span>
          </div>
          <span class="rg__case-num">01</span>
          <div class="rg__case-title">Белое родирование</div>
          <p class="rg__case-text">
            Холодный серебристый блеск. Наносится на серебро и белое золото
            для защиты и восстановления вида. После родирования серебро
            не отличить от белого золота. Держится 2–5 лет в зависимости
            от типа украшения.
          </p>
        </div>
        <div class="rg__case">
          <div class="rg__card-img">
            <span>Фото — серебряное кольцо с жёлтым позолотой</span>
          </div>
          <span class="rg__case-num">02</span>
          <div class="rg__case-title">Жёлтое или розовое золочение</div>
          <p class="rg__case-text">
            Покрытие золотом 585 или 999 пробы — классический жёлтый или
            тёплый розово-красный оттенок. Украшение выглядит как золотое
            по доступной цене. Позолота держится 2–5 лет при аккуратной носке.
          </p>
        </div>
        <div class="rg__case">
          <div class="rg__card-img">
            <span>Фото — серебряное кольцо с чёрным родированием</span>
          </div>
          <span class="rg__case-num">03</span>
          <div class="rg__case-title">Чёрное родирование</div>
          <p class="rg__case-text">
            Покрытие чёрным родием для контрастного эффекта. Популярно для
            мужских украшений и изделий в винтажном или готическом стиле.
            Даёт матово-угольный или зеркально-чёрный вид.
          </p>
        </div>
        <div class="rg__case">
          <div class="rg__card-img">
            <span>Фото — серебряные серьги с серебрением крупным планом</span>
          </div>
          <span class="rg__case-num">04</span>
          <div class="rg__case-title">Серебрение</div>
          <p class="rg__case-text">
            Покрытие тонким слоем серебра. Используется для восстановления
            потускневших изделий из недрагоценных сплавов или как промежуточный
            слой перед нанесением золота или родия.
          </p>
        </div>
      </div>
    </div>

    <!-- ── От чего зависит цена ── -->
    <div class="rg__section">
      <p class="rg__label">Стоимость работы</p>
      <h2 class="rg__section-title">От чего зависит цена?</h2>
      <p class="rg__section-lead">
        Цена родирования, золочения или серебрения зависит от площади покрытия,
        сложности работы, состояния украшения и металла основы.
      </p>
      <div class="rg__cases rg__cases--3col">
        <div class="rg__case">
          <span class="rg__case-num">01</span>
          <div class="rg__case-title">Украшение крупное</div>
          <p class="rg__case-text">
            Массивная цепочка со сложным плетением или широкий браслет примут
            на себя больше материала для гальванического покрытия.
          </p>
        </div>
        <div class="rg__case">
          <span class="rg__case-num">02</span>
          <div class="rg__case-title">Изделие старое и изношенное</div>
          <p class="rg__case-text">
            Перед нанесением родия мастер удалит царапины, вмятины и потемнения.
            Дополнительные шлифовка и полировка нужны, чтобы покрытие легло
            ровно и держалось дольше.
          </p>
        </div>
        <div class="rg__case">
          <span class="rg__case-num">03</span>
          <div class="rg__case-title">Украшение из нескольких металлов</div>
          <p class="rg__case-text">
            Например, кольцо из белого и красного золота, а родировать нужно
            только белую часть. Ювелир закроет нужные фрагменты лаком, нанесёт
            покрытие, потом снимет лак.
          </p>
        </div>
        <div class="rg__case">
          <span class="rg__case-num">04</span>
          <div class="rg__case-title">Сложная работа с камнями</div>
          <p class="rg__case-text">
            На кольце россыпь мелких камней, а покрыть родием нужно только
            тонкую оправу между ними. Мастер работает гальваническим
            карандашом. Процесс медленный: важно не задеть вставки.
          </p>
        </div>
        <div class="rg__case">
          <span class="rg__case-num">05</span>
          <div class="rg__case-title">Украшение из недрагоценного металла</div>
          <p class="rg__case-text">
            Латунь и медь плохо держат родий и золото. Сначала мастер покроет
            изделие серебром или никелем, потом нанесёт финишное покрытие.
            Без промежуточного слоя позолота сойдёт за несколько дней.
          </p>
        </div>
      </div>
    </div>

    <!-- ── Сколько держится покрытие ── -->
    <div class="rg__section">
      <p class="rg__label">Срок службы</p>
      <h2 class="rg__section-title">Сколько держится родирование и золочение</h2>
      <p class="rg__section-lead">
        При активном использовании срок зависит от того, насколько часто
        украшение контактирует с поверхностями.
      </p>
      <div class="rg__durability">
        <div class="rg__dur-item">
          <div class="rg__dur-num">2–3</div>
          <div class="rg__dur-unit">года</div>
          <div class="rg__dur-title">Кольца</div>
          <p class="rg__dur-text">Постоянно контактируют с поверхностями — руль, клавиатура, ключи.</p>
        </div>
        <div class="rg__dur-item">
          <div class="rg__dur-num">3–5</div>
          <div class="rg__dur-unit">лет</div>
          <div class="rg__dur-title">Браслеты и цепочки</div>
          <p class="rg__dur-text">Звенья трутся друг о друга, но меньший контакт с твёрдыми поверхностями.</p>
        </div>
        <div class="rg__dur-item">
          <div class="rg__dur-num">5–10</div>
          <div class="rg__dur-unit">лет</div>
          <div class="rg__dur-title">Серьги и кулоны</div>
          <p class="rg__dur-text">Минимальное трение. При аккуратной носке и правильном хранении — долгие годы.</p>
        </div>
      </div>
      <div class="rg__durability-signs">
        <div class="rg__signs-title">Признаки того, что пора обновить покрытие:</div>
        <ul class="rg__signs-list">
          <li>Серебро потемнело или покрылось налётом</li>
          <li>На белом золоте проступил желтоватый оттенок</li>
          <li>Украшение потеряло холодный блеск</li>
          <li>Видны царапины и потёртости</li>
          <li>Кончики зубцов оправы изменили цвет</li>
        </ul>
      </div>
    </div>

    <!-- ── Как делаем ── -->
    <div class="rg__section">
      <p class="rg__label">Технология</p>
      <h2 class="rg__section-title">Как мы делаем родирование</h2>
      <div class="rg__process">
        {
          processSteps.map((step) => (
            <div class="rg__process-step">
              <div class="rg__process-num">{step.num}</div>
              <div class="rg__process-title">{step.title}</div>
              <p class="rg__process-text">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ── Уход ── -->
    <div class="rg__section rg__section--warm">
      <p class="rg__label">После процедуры</p>
      <h2 class="rg__section-title">Как ухаживать за родированными украшениями</h2>
      <div class="rg__care">
        <div class="rg__care-col">
          <div class="rg__care-col-title">Что делать</div>
          <ul class="rg__care-list rg__care-list--do">
            <li>Протирайте мягкой тканью после каждой носки</li>
            <li>Храните в отдельных мешочках или ячейках шкатулки</li>
            <li>Снимайте перед уборкой, мытьём посуды, походом в бассейн</li>
            <li>Надевайте после нанесения крема и макияжа</li>
          </ul>
